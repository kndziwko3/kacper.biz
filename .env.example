# kacper.biz — lead capture (api/lead.js)
#
# Copy to .env for `npx vercel dev`, and set the same names in Vercel:
#   Project -> Settings -> Environment Variables (Production + Preview).
# NEVER commit real values; .env and .env.* are git-ignored (only this file is tracked).
#
# The function reads these on every request. If neither RESEND_API_KEY nor LEAD_WEBHOOK_URL is set,
# POST /api/lead answers 503 { fallback: "mailto" } and the form opens a prefilled mailto: instead.
# Delivery order: Resend first, then the webhook (also used if Resend fails).

# --- Delivery option 1: Resend (https://resend.com) — email notification --------------------------
# API key with "sending access" only.
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separated list allowed. Default: kontakt@fastlanding.io
LEAD_TO=

# Sender, e.g.  kacper.biz <leads@kacper.biz>
# Must be on a domain VERIFIED in Resend (SPF/DKIM). If empty the function uses Resend's shared test
# sender (onboarding@resend.dev), which only delivers to the Resend account owner's own address —
# fine for a smoke test, not for production.
LEAD_FROM=

# Reply-To header. Empty or "visitor" = the visitor's own email (default), so "Reply" answers them.
# "off" = no Reply-To. Or a fixed address, e.g. sales@kacper.biz.
LEAD_REPLY_TO=

# --- Delivery option 2: generic webhook (Zapier / Make / n8n / Slack incoming webhook / your CRM) ---
# The function POSTs JSON: { event, site, received_at, subject, text, lead: {...}, attribution: {...} }.
# Treat the URL as a secret (it usually carries the auth token).
LEAD_WEBHOOK_URL=

# --- Security -----------------------------------------------------------------------------------
# The same-origin check allows kacper.biz, www.kacper.biz, localhost and *.vercel.app previews.
# Set to 0 in production if you do not want any *.vercel.app origin accepted.
LEAD_ALLOW_VERCEL_ORIGINS=
