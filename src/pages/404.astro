---
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Sheet from '../components/ui/Sheet.astro';
import Btn from '../components/ui/Btn.astro';
import { copy } from '../content/copy';
import { NAV } from '../content/site';
const n = copy.pl.notFound;
const e = copy.en.notFound;
const f = copy.pl.film;
---
<Base lang="pl" path="/404" title={n.title} description={n.p} noindex still="p1">
  <PageHead lang="pl" crumb="404" h1={n.h1} lead={n.p} pose={1} short guide={f.guide.notFound}>
    <Btn href="/">{n.btn}</Btn>
    <Btn href="/en" variant="ghost">{e.btn}</Btn>
  </PageHead>
  <Sheet guide={f.guide.notFound}>
    <div class="grid pg-two">
      <p class="t-lead dim pg-main" lang="en">{e.p}</p>
      <ul class="rows pg-side">
        {NAV.pl.map((i) => <li><a class="k tlink" href={i.href}>{i.label}</a><span class="v t-label dim">{f.navNotes[i.href] ?? ''}</span></li>)}
      </ul>
    </div>
  </Sheet>
</Base>
