---
import { NAV, ROUTE_PAIRS, type Lang } from '../content/site';
import { copy } from '../content/copy';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const ui = copy[lang].ui;
const items = NAV[lang];
const pair = ROUTE_PAIRS.find((r) => r.pl === path || r.en === path);
const otherLang: Lang = lang === 'pl' ? 'en' : 'pl';
const otherHref = pair ? pair[otherLang] : otherLang === 'pl' ? '/' : '/en';
const homeHref = lang === 'pl' ? '/' : '/en';
const contactHref = lang === 'pl' ? '/kontakt' : '/en/contact';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="site-header__bar">
    <a class="brand" href={homeHref} aria-label="Kacper Rękawek — kacper.biz">
      <span class="brand__mark" aria-hidden="true">KR</span>
      <span>kacper<span class="faint">.biz</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      {items.map((i) => <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <div class="site-header__end">
      <a class="lang" href={otherHref} hreflang={otherLang === 'pl' ? 'pl-PL' : 'en'} lang={otherLang} aria-label={ui.langLabel}>{ui.langSwitch}</a>
      <a class="btn btn--signal nav-cta" href={contactHref} style="min-height:42px;padding:.5rem 1.1rem;font-size:.92rem">{ui.write}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={ui.menu}><span></span></button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
    {items.map((i) => <a href={i.href}>{i.label}</a>)}
  </nav>
</header>
<style>
  .nav-cta { display: none; }
  @media (min-width: 640px) { .nav-cta { display: inline-flex; } }
</style>
