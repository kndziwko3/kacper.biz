---
/**
 * The header floats over the film and the sheets: every item is a solid key (graphite caps, the copper cap books the
 * call), so it reads on black and on cream, and it goes down 2 px when pressed like the board's own keys; on the home page the chapter rail (Rail.astro) does the wayfinding.
 */
import { NAV, ROUTE_PAIRS, CONTACT, SALES, type Lang } from '../content/site';
import { copy } from '../content/copy';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const c = copy[lang];
const f = c.film;
const ui = c.ui;
const items = NAV[lang];
const pair = ROUTE_PAIRS.find((r) => r.pl === path || r.en === path);
const otherLang: Lang = lang === 'pl' ? 'en' : 'pl';
const otherHref = pair ? pair[otherLang] : otherLang === 'pl' ? '/' : '/en';
const home = lang === 'pl' ? '/' : '/en';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hd" transition:animate="none">
  <a class="hp hd-mark" href={home} aria-label={`Kacper Rękawek, ${ui.home}`}>kacper.biz</a>
  <div class="hd-end">
    <a class="hp hd-lang" href={otherHref} hreflang={otherLang === 'pl' ? 'pl-PL' : 'en'} lang={otherLang} aria-label={ui.langLabel} data-astro-reload>{ui.langSwitch}</a>
    <a class="btn hd-book" href={SALES.bookingUrl} data-outbound data-cta="head-booking" rel="noopener"><span class="hd-lg">{f.book}</span><span class="hd-sm">{f.bookShort}</span></a>
    <button class="hp hd-menu" type="button" aria-expanded="false" aria-controls="menu">{f.menu}</button>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={f.menuTitle}>
  <div class="menu-top">
    <a class="hp" href={home}>kacper.biz</a>
    <button class="hp" type="button" data-menu-close>{ui.close}</button>
  </div>
  <nav class="menu-nav" aria-label={f.menuTitle}>
    <ul>
      <li><a href={home} aria-current={path === home ? 'page' : undefined}><span class="menu-name">{ui.home}</span><span class="t-label menu-note">Kacper Rękawek</span></a></li>
      {items.map((i) => (
        <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}><span class="menu-name">{i.label}</span><span class="t-label menu-note">{f.navNotes[i.href] ?? ''}</span></a></li>
      ))}
    </ul>
  </nav>
  <div class="menu-foot">
    <a class="btn" href={SALES.bookingUrl} data-outbound data-cta="menu-booking" rel="noopener">{f.book}</a>
    <a class="tlink" href={`mailto:${CONTACT.studioEmail}`}>{CONTACT.studioEmail}</a>
    <a class="tlink" href={otherHref} lang={otherLang} data-astro-reload>{otherLang === 'pl' ? 'Polski' : 'English'}</a>
  </div>
</div>

<style>
  .hd { position: fixed; z-index: 50; inset: 0 0 auto; height: var(--head-h); padding-inline: var(--gutter); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; pointer-events: none; }
  .hd > * { pointer-events: auto; }
  /* a band of the ground under the pills, so copy scrolling up never runs into them (paper over a sheet) */
  .hd::before { content: ''; position: absolute; inset: 0 0 -1.5rem; z-index: -1; pointer-events: none; background: linear-gradient(to bottom, rgba(14, 12, 10, 0.94) 0%, rgba(14, 12, 10, 0.94) 58%, rgba(14, 12, 10, 0)); transition: opacity 0.25s var(--ease); }
  .hd::after { content: ''; position: absolute; inset: 0 0 -1.5rem; z-index: -1; pointer-events: none; background: linear-gradient(to bottom, rgba(237, 231, 220, 0.96) 0%, rgba(237, 231, 220, 0.96) 58%, rgba(237, 231, 220, 0)); opacity: 0; transition: opacity 0.25s var(--ease); }
  :global(html.hd-paper) .hd::before { opacity: 0; }
  :global(html.hd-paper) .hd::after { opacity: 1; }
  .hp { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.55rem 1.05rem 0.62rem; border-radius: var(--cap-r); background: #1c1916; color: var(--text); box-shadow: inset 0 0 0 1px rgba(237, 230, 218, 0.1), inset 0 -3px 0 rgba(0, 0, 0, 0.45); font: 500 0.95rem/1 var(--f-sans); letter-spacing: -0.01em; transition: box-shadow 0.15s var(--ease), transform 0.12s var(--ease); }
  .hp:hover { box-shadow: inset 0 0 0 1px rgba(237, 230, 218, 0.36), inset 0 -3px 0 rgba(0, 0, 0, 0.45); }
  .hp:active { transform: translateY(2px); box-shadow: inset 0 0 0 1px rgba(237, 230, 218, 0.2), inset 0 -1px 0 rgba(0, 0, 0, 0.45); }
  .hd-mark { justify-self: start; font-weight: 600; }
  .hd-end { justify-self: end; display: flex; gap: 0.5rem; align-items: center; }
  .hd-book { min-height: 2.75rem; padding: 0.55rem 1.1rem 0.62rem; font-size: 0.95rem; }
  .hd-lg { display: none; }
  @media (min-width: 760px) { .hd-lg { display: inline; } .hd-sm { display: none; } }
  @media (max-width: 420px) { .hd-lang { display: none; } }

  .menu { position: fixed; inset: 0; z-index: 60; background: var(--studio); color: var(--text); display: flex; flex-direction: column; padding: 0 var(--gutter) max(1.5rem, env(safe-area-inset-bottom)); visibility: hidden; opacity: 0; transition: opacity 0.3s var(--ease), visibility 0s linear 0.3s; overflow-y: auto; }
  .menu.is-open { visibility: visible; opacity: 1; transition: opacity 0.3s var(--ease); }
  .menu-top { height: var(--head-h); display: flex; justify-content: space-between; align-items: center; }
  .menu-nav { margin-top: clamp(1.5rem, 6vh, 4rem); }
  .menu-nav li + li { border-top: 1px solid var(--line-d); }
  .menu-nav a { display: grid; gap: 0.35rem; padding-block: clamp(0.8rem, 2vh, 1.2rem); }
  @media (min-width: 760px) { .menu-nav a { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; } }
  .menu-name { font: 500 clamp(2.2rem, 1.2rem + 4vw, 4.6rem)/1 var(--f-display); letter-spacing: -0.035em; transition: color 0.2s; }
  .menu-note { color: var(--text-2); }
  .menu-nav a:hover .menu-name, .menu-nav a[aria-current='page'] .menu-name { color: var(--copper-hi); }
  .menu-foot { margin-top: auto; padding-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem 1.75rem; align-items: center; }
</style>
