---
import { NAV, ROUTE_PAIRS, CONTACT, type Lang } from '../content/site';
import { copy } from '../content/copy';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const ui = copy[lang].ui;
const items = NAV[lang];
const pair = ROUTE_PAIRS.find((r) => r.pl === path || r.en === path);
const otherLang: Lang = lang === 'pl' ? 'en' : 'pl';
const otherHref = pair ? pair[otherLang] : otherLang === 'pl' ? '/' : '/en';
const homeHref = lang === 'pl' ? '/' : '/en';
const contactHref = lang === 'pl' ? '/kontakt' : '/en/contact';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header" transition:animate="none">
  <div class="wrap">
    <a class="wordmark" href={homeHref}><i aria-hidden="true"></i>Kacper Rękawek</a>
    <nav class="nav" aria-label={lang === 'pl' ? 'Główna' : 'Main'}>
      {items.map((i) => <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <div class="header-end">
      <span class="clock" aria-hidden="true"><span>{ui.place}</span> <time data-clock>--:--</time></span>
      <a class="lang" href={otherHref} hreflang={otherLang === 'pl' ? 'pl-PL' : 'en'} lang={otherLang} aria-label={ui.langLabel} data-astro-reload>{ui.langSwitch}</a>
      <a class="header-cta link link--u" href={contactHref}>{ui.write}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label={ui.menu}><span></span></button>
    </div>
  </div>
</header>
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={ui.menu}>
  <div class="menu-top">
    <a class="wordmark" href={homeHref}><i aria-hidden="true"></i>Kacper Rękawek</a>
    <button class="menu-close lang" type="button" data-menu-close>{ui.close}</button>
  </div>
  <nav aria-label={lang === 'pl' ? 'Menu mobilne' : 'Mobile menu'}>
    {items.map((i) => <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>)}
  </nav>
  <div class="menu-foot">
    <a href={`mailto:${CONTACT.studioEmail}`}>{CONTACT.studioEmail}</a>
    <a href={otherHref} lang={otherLang} data-astro-reload>{otherLang === 'pl' ? 'Polski' : 'English'}</a>
    <span class="data">{ui.place} · {ui.coords}</span>
  </div>
</div>
