---
/** Questions, set open on the sheet (no accordions: the answers are the content, for people and for AI answers). */
import Sheet from './ui/Sheet.astro';
import { copy } from '../content/copy';
import type { Lang } from '../content/site';
interface Props { lang: Lang; items?: { q: string; a: string }[]; h2?: string }
const { lang, items, h2 } = Astro.props;
const list = items ?? copy[lang].faq;
const f = copy[lang].film;
---
<Sheet id="pytania" labelledby="faq-h" guide={f.guide.faq}>
  <div class="grid faq">
    <div class="faq-head">
      <h2 class="t-h2" id="faq-h">{h2 ?? copy[lang].home.faq.h2}</h2>
    </div>
    <dl class="faq-list">
      {list.map((it) => (
        <div class="faq-item">
          <dt class="t-h3">{it.q}</dt>
          <dd class="t-body dim">{it.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</Sheet>
<style>
  .faq { row-gap: 2.5rem; align-items: start; padding-top: clamp(4rem, 10vh, 7rem); border-top: 1px solid var(--line-p); }
  .faq-head { display: grid; gap: 1rem; align-content: start; }
  .faq-list { border-top: 1px solid var(--line-p); }
  .faq-item { display: grid; gap: 0.75rem; padding-block: 1.5rem 1.75rem; border-bottom: 1px solid var(--line-p); }
  .faq-item dd { max-width: 64ch; }
  @media (min-width: 960px) {
    .faq-head { grid-column: 1 / 5; position: sticky; top: calc(var(--head-h) + 1.5rem); }
    .faq-list { grid-column: 6 / 13; }
  }
</style>
