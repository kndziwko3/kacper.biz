---
/** Questions, printed open on white stock (no accordions: the answers are the content, for people and for AI answers). */
import { copy } from '../content/copy';
import type { Lang } from '../content/site';
interface Props { lang: Lang; heading?: boolean; items?: { q: string; a: string }[] }
const { lang, heading = true, items } = Astro.props;
const list = items ?? copy[lang].faq;
const d = copy[lang].dir;
---
<section id="pytania" class="faq-sec stock-white" data-guide={d.guide.faq} data-scene-occlude aria-labelledby="faq-h">
  <div class="wrap">
    <div class="cat faq-cat">
      <h2 class="v-cat" id="faq-h">{heading ? d.faq.cat : copy[lang].home.faq.h2}</h2>
    </div>
    <dl class="faq-list">
      {list.map((it) => (
        <div class="faq-item">
          <dt class="v-head">{it.q}</dt>
          <dd class="v-body">{it.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .faq-sec { padding-block: clamp(4rem, 10vh, 7rem); border-bottom: 2px solid var(--ink); }
  /* set like the directory's own pages: two columns split by a hairline column rule, questions in the listing voice */
  .faq-list { margin-top: 1.75rem; border-top: 2px solid var(--ink); }
  @media (min-width: 900px) { .faq-list { columns: 2; column-gap: calc(var(--col-gap) * 2); column-rule: 1px solid var(--ink); } }
  .faq-item { padding-block: 1rem 1.3rem; break-inside: avoid; }
  .faq-item + .faq-item { border-top: 1px solid var(--ink); }
  .faq-item dd { margin-top: 0.55rem; }
</style>
