---
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pr = copy[lang].home.fl.process;
---
<div class="process">
  <h3 class="v-list pr-h">{pr.h3}</h3>
  <ol class="pr-steps">
    {pr.steps.map(([t, d], i) => (
      <li><span class="pr-n" aria-hidden="true">{i + 1}</span><b class="v-head">{t}</b><span class="v-small">{d}</span></li>
    ))}
  </ol>
</div>
<style>
  .pr-h { padding-bottom: 0.4rem; border-bottom: 8px solid var(--ink); }
  .pr-steps { display: grid; }
  .pr-steps li { display: grid; grid-template-columns: 2.6rem 1fr; column-gap: 0.75rem; row-gap: 0.25rem; padding: 0.9rem 0; border-bottom: 1px solid var(--ink); }
  .pr-steps li > :not(.pr-n) { grid-column: 2; }
  .pr-n { grid-row: span 2; font-stretch: var(--w-display); font-weight: 900; font-size: 2.4rem; line-height: 0.85; }
  @media (min-width: 960px) {
    .pr-steps { grid-template-columns: repeat(5, 1fr); column-gap: var(--col-gap); border-top: 0; }
    .pr-steps li { grid-template-columns: 1fr; border-bottom: 0; border-top: 2px solid var(--ink); padding-top: 0.8rem; }
    .pr-steps li > :not(.pr-n) { grid-column: 1; }
    .pr-n { grid-row: auto; font-size: 3rem; margin-bottom: 0.5rem; }
  }
</style>
