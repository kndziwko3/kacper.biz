---
/**
 * 3 in 100, on the white pages: every micro-firm is listed, only a few list a website. The 100 entries are an
 * illustration in the report's proportion (names greeked, labelled as such); the filter mirrors OutreachPilot's
 * "no website" filter and leaves the 97 firms you could write to first.
 */
import { copy } from '../../content/copy';
import { PRODUCTS, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].home.thesis;
const d = copy[lang].dir;
const ui = copy[lang].ui;
// deterministic greeked names: two words per entry, widths from a tiny LCG so every build prints the same page
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const WWW = new Set([14, 58, 87]);
const rows = Array.from({ length: 100 }, (_, i) => ({ a: 34 + Math.round(rnd() * 30), b: 18 + Math.round(rnd() * 34), www: WWW.has(i) }));
---
<section id="bez-www" class="three stock-white sec" data-guide={d.guide.three} data-scene-occlude aria-labelledby="three-h">
  <div class="wrap grid three-grid">
    <div class="three-text c-1-5">
      <h2 class="v-state" id="three-h">{t.h2}</h2>
      <p class="v-body three-p">{t.p}</p>
      <p class="src">{ui.source}: <a href={PRODUCTS.outreachpilot.noWebsiteReport} data-outbound data-cta="thesis-source" rel="noopener">{t.source}</a></p>
      <div class="three-ctl">
        <button class="btn btn--line" type="button" aria-pressed="false" aria-controls="wp-list" data-www-filter data-on={d.three.filterOn} data-off={d.three.filterOff}>{d.three.filterOn}</button>
        <p class="v-small">{d.three.filterNote}</p>
      </div>
    </div>
    <figure class="three-fig c-6-12" data-www>
      <ol class="wp" id="wp-list" aria-hidden="true">
        {rows.map((r, i) => (
          <li class:list={['ld', r.www && 'is-www']} style={`--i:${i}`}>
            <span class="g"><b style={`width:${r.a}%`}></b><b style={`width:${r.b}%`}></b></span><i></i><span class="wp-v">{r.www ? d.three.www : d.three.tel}</span>
          </li>
        ))}
      </ol>
      <figcaption class="src">{d.three.ill}</figcaption>
    </figure>
  </div>
</section>

<style>
  .three { border-bottom: 2px solid var(--ink); }
  .three-grid { row-gap: 2.5rem; align-items: start; }
  .three-p { margin-top: 1.25rem; }
  .three-text .src { margin-top: 1rem; }
  .three-ctl { margin-top: 2rem; display: grid; gap: 0.6rem; justify-items: start; }
  .three-ctl .v-small { max-width: 38ch; }
  @media (min-width: 960px) { .three-text { position: sticky; top: calc(var(--head-h) + 2rem); } }

  .three-fig { border-top: 8px solid var(--ink); padding-top: 0.6rem; }
  /* four columns of 25 at every width, so the whole page and its three red marks fit one screen on a phone */
  .wp { columns: 4; column-gap: 0.9rem; column-rule: 1px solid var(--ink); font-size: 0.7rem; }
  @media (min-width: 700px) { .wp { column-gap: 1.6rem; font-size: 0.8rem; } }
  .wp li { break-inside: avoid; padding-block: 0.2rem; transition: opacity 0.35s var(--ease); }
  .g { display: flex; gap: 0.3em; flex: 0 0 56%; align-items: center; }
  .g b { display: block; height: 0.5em; background: currentColor; opacity: 0.8; }
  .wp-v { font-stretch: var(--w-list); font-weight: 750; font-size: 0.72rem; letter-spacing: 0.03em; }
  @media (max-width: 699px) {
    .wp li { padding-block: 0.12rem; }
    .g { flex-basis: 48%; gap: 0.2em; }
    .wp-v { font-size: 0.6rem; letter-spacing: 0.02em; }
    .wp .ld { gap: 0.25em; }
    .wp .ld > i { min-width: 0.5em; }
    .wp .is-www .wp-v { padding: 0 0.2em; }
  }
  .wp .is-www { color: var(--red-deep); }
  .wp .is-www .g b { opacity: 1; }
  .wp .is-www .wp-v { background: var(--red); color: #fff; padding: 0 0.3em; }
  .three-fig figcaption { margin-top: 0.9rem; }

  /* filter on: the three with a website drop out, the 97 prospects stay, marked */
  .three-fig.is-filtered .is-www { opacity: 0.08; }
  .three-fig.is-filtered li:not(.is-www) .wp-v { color: var(--red-deep); }
  .three-fig.is-filtered li:not(.is-www) { transition-delay: calc(var(--i) * 4ms); }
</style>

<script>
  // Toggles the "no website" filter; re-bound on every page swap by the lifecycle in main.ts.
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-www-filter]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const fig = document.querySelector<HTMLElement>('[data-www]');
      btn.addEventListener('click', () => {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        btn.textContent = (on ? btn.dataset.off : btn.dataset.on) ?? '';
        fig?.classList.toggle('is-filtered', on);
      });
    });
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
