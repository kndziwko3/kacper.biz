---
/**
 * OutreachPilot.pl, as a directory department: category head, a clean window onto the printed map (emails leave,
 * replies return), the four-step flow with a sticky proof panel, results, the rate card and the reversed ad.
 */
import Btn from '../ui/Btn.astro';
import Pane from './Pane.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, type Lang } from '../../content/site';
interface Props { lang: Lang; heading?: boolean }
const { lang, heading = true } = Astro.props;
const c = copy[lang];
const o = c.home.op;
const dir = c.dir.op;
const plans = c.op.plans;
const n = o.steps.length;
---
<section id="outreachpilot" class="op" data-guide={c.dir.guide.op} aria-labelledby={heading ? 'op-h' : undefined} aria-label={heading ? undefined : dir.cat}>
  {heading && (
    <div class="op-head stock-yellow" data-scene-occlude>
      <div class="wrap grid">
        <div class="cat c-1-12"><h2 class="v-cat" id="op-h">{dir.cat}</h2></div>
        <p class="v-state c-1-8 op-state">{o.h2}</p>
        <p class="v-lead c-9-12 op-p">{o.p}</p>
      </div>
    </div>
  )}

  <div class="op-map" data-poster data-scene="2" data-scene-side="center" aria-hidden="true">
    <div class="wrap"><p class="v-micro op-map-cap">{dir.mapCap}</p></div>
  </div>

  <div class="op-body stock-yellow" data-scene-occlude>
    <div class="wrap">
      <div class="grid instrument" data-instrument>
        <ol class="steps c-1-5">
          {o.steps.map((s, i) => (
            <li class="step" data-step={i}>
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <h3 class="v-head">{s.title}</h3>
              <p class="v-body">{s.text}</p>
              <div class="step-pane"><Pane lang={lang} panel={s.panel} /></div>
            </li>
          ))}
        </ol>
        <div class="panel-col c-7-12" aria-hidden="true">
          <div class="panel">
            <div class="panel-bar"><span>outreachpilot.pl</span><span>{dir.step} <b data-panel-count>1</b> {dir.of} {n}</span></div>
            {o.steps.map((s, i) => (
              <div class="panel-pane" data-pane={i}><Pane lang={lang} panel={s.panel} /></div>
            ))}
          </div>
        </div>
      </div>

      <div class="grid op-proof">
        <div class="c-1-6 bench">
          <h3 class="v-list bench-h">{dir.bench}</h3>
          <ul class="bench-list">
            {o.benchmark.stats.map(([v, l]) => (<li class="ld"><span>{l}</span><i></i><span class="bench-v">{v}</span></li>))}
          </ul>
          <p class="src">{o.benchmark.note} <a href={PRODUCTS.outreachpilot.methodology} data-outbound data-cta="op-methodology" rel="noopener">{o.benchmark.link}</a></p>
        </div>
        <div class="c-7-12 rate">
          <h3 class="v-list bench-h">{dir.rate}</h3>
          <ul class="rate-list">
            {plans.rows.map(([name, price, what]) => (
              <li><span class="ld"><b>{name}</b><i></i><span class="rate-p">{price}</span></span><span class="v-micro">{what}</span></li>
            ))}
          </ul>
          <p class="src">{plans.note}</p>
        </div>
      </div>

      <div class="grid op-close">
        <article class="ad ad--rev c-1-8 op-ad" aria-labelledby="op-ad-h">
          <h3 class="ad-h" id="op-ad-h">{dir.ctaH}</h3>
          <p>{dir.ctaP} {o.mcp} <a class="tlink" href={PRODUCTS.outreachpilot.mcp} data-outbound data-cta="op-mcp" rel="noopener">MCP</a></p>
          <div class="ad-foot">
            <span class="sticker">{c.dir.entry.adOp.price} <small>{c.dir.entry.adOp.priceNote}</small></span>
            <div class="btn-row">
              <Btn href={PRODUCTS.outreachpilot.signup} outbound cta="op-signup">{o.cta}</Btn>
              <Btn href={PRODUCTS.outreachpilot.pricing} variant="line" outbound cta="op-pricing">{o.ctaAlt}</Btn>
            </div>
          </div>
          <p class="ad-sig ld"><b>OutreachPilot.pl</b><i></i><span>{c.dir.sig.op}</span></p>
        </article>
        <p class="src c-9-12 op-legal">{o.legal}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .op { position: relative; border-bottom: 2px solid var(--ink); }
  .op-head { padding-block: clamp(4rem, 10vh, 7rem) clamp(2rem, 5vh, 3rem); }
  .op-state { margin-top: 1.25rem; }
  .op-p { margin-top: 1.25rem; color: var(--fg-2); }
  @media (min-width: 960px) { .op-p { align-self: end; } }

  /* the window: nothing but the printed map and one caption */
  .op-map { position: relative; height: clamp(24rem, 78vh, 46rem); display: flex; align-items: flex-end; padding-bottom: 1.25rem; --mx: 50%; --mw: min(46vw, 80vh); --mt: 38deg; --my-m: 50%; }
  .op-map-cap { max-width: 44ch; background: var(--yellow); padding: 0.35rem 0.5rem; margin-left: -0.5rem; color: var(--fg-2); }

  .op-body { padding-block: clamp(3rem, 8vh, 5rem) clamp(4rem, 10vh, 6rem); }
  .instrument { align-items: start; }
  .step { position: relative; padding: 1.25rem 0 2rem; border-top: 2px solid var(--ink); display: grid; grid-template-columns: 3.2rem 1fr; column-gap: 1rem; align-content: start; }
  .step > :not(.step-n) { grid-column: 2; }
  .step-n { grid-row: span 3; font-stretch: var(--w-display); font-weight: 900; font-size: 3.2rem; line-height: 0.8; }
  .step .v-body { margin-top: 0.5rem; }
  .step-pane { margin-top: 1rem; }
  .panel-col { display: none; }
  @media (min-width: 960px) {
    .step { min-height: 56vh; padding-bottom: 0; }
    :global(.js) .step:not(.is-active) :is(.v-head, .v-body) { color: var(--fg-3); }
    :global(.js) .step:not(.is-active) .step-n { color: var(--fg-3); }
    :global(.js) .step.is-active .step-n { color: var(--red-deep); }
    .step :is(.v-head, .v-body, .step-n) { transition: color 0.25s var(--ease); }
    .step-pane { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .panel-col { display: block; position: sticky; top: calc(50vh - 11rem); }
  }
  .panel { position: relative; min-height: 23rem; border: var(--frame) solid var(--ink); background: var(--white); --stock: var(--white); }
  .panel-bar { display: flex; justify-content: space-between; padding: 0.45rem 0.9rem; background: var(--ink); color: var(--yellow); font-stretch: var(--w-list); font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-micro); }
  .panel-pane { position: absolute; inset: 2.4rem 0 0; padding: 1.2rem 1.3rem 1.4rem; opacity: 0; transform: translateY(8px); transition: opacity 0.3s var(--ease), transform 0.45s var(--ease); pointer-events: none; }
  .panel-pane.is-active { opacity: 1; transform: none; }
  :global(html:not(.js)) .panel-pane[data-pane='0'] { opacity: 1; transform: none; }

  .op-proof { margin-top: clamp(3rem, 8vh, 5rem); row-gap: 2.5rem; }
  .bench-h { padding-bottom: 0.4rem; border-bottom: 8px solid var(--ink); margin-bottom: 0.5rem; }
  .bench-list li { padding-block: 0.35rem; border-bottom: 1px solid var(--ink); font-weight: 600; }
  .bench-v { font-stretch: var(--w-display); font-weight: 900; font-size: clamp(2rem, 1.5rem + 1.5vw, 2.8rem); line-height: 1; }
  .bench .src, .rate .src { margin-top: 0.8rem; }
  .rate-list li { display: grid; gap: 0.1rem; padding-block: 0.45rem; border-bottom: 1px solid var(--ink); }
  .rate-list b { font-stretch: var(--w-list); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }
  .rate-p { font-weight: 800; }
  .op-close { margin-top: clamp(3rem, 8vh, 5rem); row-gap: 1.5rem; align-items: end; }
  .op-ad p { max-width: 62ch; }
  .op-ad .tlink { color: inherit; }
  @media (max-width: 959px) { .op-map { height: 62svh; } }
</style>
