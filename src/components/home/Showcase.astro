---
/**
 * Client sites as display ads on a proof sheet: size is billing. Each frame holds a real capture that scrolls
 * with the page (showcase.ts); the caption is the site's directory listing, checked on a stated date.
 */
import { copy, formatDate } from '../../content/copy';
import { PROJECTS, PRODUCTS, type Lang } from '../../content/site';
import { shot } from '../../content/work';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = copy[lang].home.fl.showcase;
const ui = copy[lang].ui;
const items = [
  ...PROJECTS.map((p) => ({ key: p.key, name: p.name, url: p.url, host: p.host, kind: p.kind[lang], langs: p.langs, checked: p.checked, own: false })),
  { key: 'outreachpilot', name: 'OutreachPilot.pl', url: PRODUCTS.outreachpilot.url, host: 'outreachpilot.pl', kind: s.ownKind, langs: 'PL', checked: '2026-09-27', own: true },
];
const alt = (name: string, kind: string) => (lang === 'pl' ? `Strona ${name}, ${kind}` : `${name} website, ${kind}`);
---
<div class="proofs">
  <div class="proofs-head">
    <h3 class="v-list proofs-h">{s.h3}</h3>
    <p class="src">{s.note}</p>
  </div>
  <ol class="proof-grid">
    {items.map((it, i) => {
      const t = shot(it.key, 'tour');
      return (
        <li class={`proof proof--${i}`}>
          <a class="proof-frame" href={it.url} target="_blank" rel="noopener" data-outbound={it.own ? '' : undefined} data-cta={it.own ? 'showcase-op' : `showcase-${it.key}`} aria-label={`${it.name}, ${it.host} ${ui.newTab}`}>
            <span class="proof-bar" aria-hidden="true">{it.host}</span>
            <span class="proof-view" data-tour>
              <picture>
                <source srcset={t.avif} type="image/avif" />
                <img src={t.webp} width={t.width} height={t.height} alt={alt(it.name, it.kind)} loading="lazy" decoding="async" />
              </picture>
            </span>
          </a>
          <div class="proof-cap">
            <h4 class="v-head">{it.name}</h4>
            <p class="ld v-small"><span>{it.own ? s.own : it.kind}</span><i></i><span>{it.langs}</span></p>
            <p class="v-micro">{s.checked} {formatDate(lang, it.checked)}</p>
          </div>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .proofs-head { display: grid; gap: 0.5rem; padding-bottom: 0.5rem; border-bottom: 8px solid var(--ink); }
  @media (min-width: 960px) { .proofs-head { grid-template-columns: 1fr auto; align-items: end; } }
  .proof-grid { margin-top: 1.25rem; display: grid; gap: 1.25rem var(--col-gap); }
  .proof { display: grid; gap: 0.7rem; align-content: start; }
  .proof-frame { display: block; border: var(--frame) solid var(--ink); background: #fff; }
  .proof-bar { display: block; padding: 0.35rem 0.7rem; background: var(--ink); color: var(--yellow); font-stretch: var(--w-list); font-weight: 750; letter-spacing: 0.03em; font-size: var(--t-micro); }
  .proof-view { display: block; position: relative; overflow: hidden; height: 18rem; }
  .proof-view img { width: 100%; will-change: transform; }
  .proof-frame:hover .proof-bar { background: var(--red); color: #fff; }
  .proof-frame:focus-visible { outline-offset: 4px; }
  .proof-cap .ld { margin-top: 0.3rem; }
  @media (min-width: 760px) {
    .proof-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .proof--0 { grid-column: 1 / span 7; grid-row: span 2; }
    .proof--0 .proof-view { height: min(62vh, 38rem); }
    .proof--1, .proof--2 { grid-column: 8 / -1; }
    .proof--1 .proof-view, .proof--2 .proof-view { height: min(22vh, 12rem); }
    .proof--3 { grid-column: 1 / -1; grid-template-columns: 7fr 5fr; column-gap: var(--col-gap); align-items: end; }
    .proof--3 .proof-view { height: min(40vh, 22rem); }
  }
</style>
