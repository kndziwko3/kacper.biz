---
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang].home.fl.clauses;
---
<div class="clauses">
  <h3 class="v-list cl-h">{c.h3}</h3>
  <ol class="cl-list">
    {c.items.map((t, i) => <li><span class="cl-n" aria-hidden="true">§&nbsp;{i + 1}</span><span>{t}</span></li>)}
  </ol>
</div>
<style>
  .cl-h { padding-bottom: 0.4rem; border-bottom: 8px solid var(--ink); }
  .cl-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 0.5rem; padding: 0.8rem 0; border-bottom: 1px solid var(--ink); line-height: 1.45; }
  .cl-n { font-stretch: var(--w-display); font-weight: 900; font-size: 1.15rem; line-height: 1.2; }
</style>
