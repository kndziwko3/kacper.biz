---
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang].home.fl.clauses;
---
<div class="clauses">
  <h3 class="h3">{c.h3}</h3>
  <ol class="cl-list">
    {c.items.map((t, i) => <li><span class="cl-n" aria-hidden="true">§&nbsp;{i + 1}</span><span>{t}</span></li>)}
  </ol>
</div>
<style>
  .cl-list { margin-top: 1.25rem; border-top: 1px solid var(--line-2); }
  .cl-list li { display: grid; grid-template-columns: 3.4rem 1fr; gap: 0.5rem; padding: 0.95rem 0; border-bottom: 1px solid var(--line); font-size: 1.02rem; line-height: 1.45; }
  .cl-n { font-family: var(--f-mono); font-size: 0.8rem; color: var(--signal-ink); padding-top: 0.2em; }
</style>
