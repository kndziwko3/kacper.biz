---
import Btn from '../ui/Btn.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const b = copy[lang].home.bot;
const c = b.chat;
---
<section class="bot m-window" data-scene="4" data-scene-side="left" data-scene-dim="0.3" aria-labelledby="bot-h">
  <div class="wrap grid bot-grid">
    <div class="c-1-5 bot-text m-solid">
      <p class="bot-time num" aria-hidden="true">{b.time}</p>
      <p class="label"><b>{b.label}</b></p>
      <h2 class="h2" id="bot-h" data-lines>{b.h2}</h2>
      <p class="body bot-p" data-reveal>{b.p}</p>
      <p class="note bot-price" data-reveal>{b.price}</p>
      <div class="btn-row bot-cta"><Btn href={PRODUCTS.fastlanding.bot} outbound cta="bot" arrow="up">{b.cta}</Btn></div>
    </div>
    <div class="c-7-12 m-solid">
      <figure class="chat" data-chat>
        <div class="chat-top">
          <span class="chat-av" aria-hidden="true">K</span>
          <span><b>{c.company}</b><span class="data">{c.status}</span></span>
        </div>
        <ol class="chat-log" aria-label={lang === 'pl' ? 'Przykładowa rozmowa' : 'Example conversation'}>
          <li class="chat-day data">{c.day}</li>
          <li class="msg msg--me" data-msg>{c.q1}</li>
          <li class="msg msg--bot" data-msg>{c.a1}</li>
          <li class="chips" data-msg>{c.chips.map((ch) => <span class:list={['chip', ch === c.pick && 'is-picked']}>{ch}</span>)}</li>
          <li class="msg msg--me" data-msg>{c.pick}</li>
          <li class="msg msg--bot" data-msg>{c.a2}</li>
          <li class="msg msg--me" data-msg>{c.q2}</li>
          <li class="msg-done data" data-msg><span aria-hidden="true">✓</span> {c.done}</li>
          <li class="chat-typing" aria-hidden="true" data-typing hidden><i></i><i></i><i></i></li>
        </ol>
        <figcaption class="note chat-note"><span>{c.note}</span><button type="button" class="link link--u" data-chat-replay hidden>{c.replay}</button></figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .bot { position: relative; padding-block: clamp(6rem, 16vh, 11rem); }
  .bot-grid { align-items: center; row-gap: 3rem; }
  .bot-time { font-family: var(--f-display); font-weight: 800; font-stretch: 75%; font-size: clamp(5rem, 3rem + 7vw, 10rem); letter-spacing: -0.05em; line-height: 0.8; color: var(--signal); margin: 0 0 1.5rem -0.04em; }
  .bot .h2 { margin-top: 1.25rem; max-width: 16ch; }
  .bot-p { margin-top: 1.25rem; }
  .bot-price { margin-top: 1rem; }
  .bot-cta { margin-top: 1.75rem; }
  .chat { margin: 0; max-width: 34rem; margin-left: auto; border: 1px solid var(--line-2); border-radius: 18px; background: var(--ink-2); overflow: hidden; position: relative; }
  .chat-top { display: flex; align-items: center; gap: 0.8rem; padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); }
  .chat-top b { display: block; font-weight: 600; font-size: 0.95rem; }
  .chat-top .data { display: block; }
  .chat-av { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--bone); color: var(--ink); font-family: var(--f-display); font-weight: 750; font-size: 0.8rem; }
  .chat-log { display: grid; gap: 0.6rem; padding: 1.2rem; min-height: 25rem; align-content: start; }
  .chat-day { justify-self: center; margin-bottom: 0.4rem; }
  .msg { max-width: 84%; padding: 0.7rem 0.95rem; border-radius: 16px; font-size: 0.95rem; line-height: 1.45; transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); }
  .msg--me { justify-self: end; background: var(--bone); color: var(--ink); border-bottom-right-radius: 4px; }
  .msg--bot { justify-self: start; background: var(--ink-3); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .chips { display: flex; gap: 0.4rem; flex-wrap: wrap; transition: opacity 0.5s var(--ease); }
  .chip { font-size: 0.82rem; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid var(--line-2); color: var(--mute); }
  .chip.is-picked { border-color: var(--signal); color: var(--signal); }
  .msg-done { justify-self: center; color: var(--bone); margin-top: 0.4rem; transition: opacity 0.5s var(--ease); }
  .msg-done span { color: var(--signal); }
  .chat-typing { justify-self: start; display: flex; gap: 4px; padding: 0.8rem 0.95rem; border-radius: 16px; border-bottom-left-radius: 4px; background: var(--ink-3); border: 1px solid var(--line); }
  .chat-typing[hidden] { display: none; }
  .chat-typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--mute); animation: dot 1.1s infinite; }
  .chat-typing i:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes dot { 30% { transform: translateY(-4px); opacity: 1; } 60% { transform: none; opacity: 0.5; } }
  .chat-note { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.2rem; border-top: 1px solid var(--line); }
  .chat-note button { color: var(--bone); white-space: nowrap; }
  .chat.is-playing [data-msg]:not(.is-shown) { opacity: 0; transform: translateY(8px); }
  @media (max-width: 899px) {
    .chat { margin-left: 0; }
    .bot-text { padding-top: 1rem; }
  }
</style>
