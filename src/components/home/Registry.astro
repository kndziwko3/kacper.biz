---
/**
 * Index of sectors: the signature interaction. Pick a sector in the directory index and a city tab; the result page
 * re-typesets with published CEIDG counts (rolling with damping), the email line is re-declined for the city and
 * the printed map behind pings the city. Works as a plain form without JS (the result shows the defaults).
 */
import Btn from '../ui/Btn.astro';
import { copy } from '../../content/copy';
import { SECTORS, CITIES, CEIDG, fmt, sectorUrl } from '../../content/ceidg';
import { typo } from '../../lib/typo';
import type { Lang } from '../../content/site';
interface Props { lang: Lang; id?: string; heading?: boolean }
const { lang, id = 'indeks', heading = true } = Astro.props;
const d = copy[lang].home.demo;
const dir = copy[lang].dir;
const ui = copy[lang].ui;
const defSector = SECTORS.find((s) => s.slug === 'elektrycy')!;
const defCity = CITIES.find((c) => c.slug === 'krakow')!;
const mailParts = d.mail.split('{in}');
const cityKey = d.cityCount.includes('{in}') ? 'in' : 'name';
const cityParts = typo(d.cityCount, lang).split(`{${cityKey}}`);
const cityForm = (c: { in: string; name: string }) => (cityKey === 'in' ? c.in : c.name);
const payload = {
  lang,
  sectors: SECTORS.map((s) => ({ slug: s.slug, count: s.count, name: s.name[lang], url: sectorUrl(s) })),
  cities: CITIES.map((c) => ({ slug: c.slug, count: c.count, name: c.name, in: c.in, lat: c.lat, lon: c.lon })),
};
const sorted = [...SECTORS].sort((a, b) => a.name[lang].localeCompare(b.name[lang], lang));
---
<section id={id} class="index m-window" data-poster data-scene="1" data-scene-side="left" data-guide={dir.guide.lookup} aria-labelledby={`${id}-h`}>
  <div class="wrap grid">
    <div class="ix c-1-6 m-solid">
      <div class="cat">
        {heading ? <h2 class="v-cat" id={`${id}-h`}>{dir.lookup.cat}</h2> : <h2 class="v-cat" id={`${id}-h`}>{d.h2}</h2>}
      </div>
      <p class="v-lead ix-lead">{d.p}</p>

      <form class="ix-form" data-registry aria-label={dir.lookup.cat} onsubmit="return false">
        <fieldset class="ix-sectors">
          <legend class="sr-only">{d.sector}</legend>
          <p class="v-micro ix-cap" aria-hidden="true">{dir.lookup.listLabel}</p>
          <ol class="ix-list">
            {sorted.map((s) => (
              <li>
                <label class="ix-row">
                  <input type="radio" name="sector" value={s.slug} checked={s.slug === defSector.slug} />
                  <span class="ld"><span class="ix-name">{s.name[lang]}</span><i></i><span class="num">{fmt(s.count, lang)}</span></span>
                </label>
              </li>
            ))}
          </ol>
        </fieldset>

        <fieldset class="ix-cities">
          <legend class="v-list">{dir.lookup.pickCity}</legend>
          <div class="ix-tabs">
            {CITIES.map((c) => (
              <label class="ix-tab"><input type="radio" name="city" value={c.slug} checked={c.slug === defCity.slug} /><span>{c.name}</span></label>
            ))}
          </div>
        </fieldset>
      </form>

      <div class="ix-page" aria-live="polite" aria-atomic="true">
        <p class="ix-rh" aria-hidden="true"><span data-out="sectorName">{defSector.name[lang]}</span><span data-out="cityName">{defCity.name}</span></p>
        <div class="ix-counts">
          <p class="ix-count"><span class="ix-n num" data-out="sector">{fmt(defSector.count, lang)}</span> <span class="v-small" set:html={typo(d.sectorCount, lang)} /></p>
          <p class="ix-count"><span class="ix-n num" data-out="city">{fmt(defCity.count, lang)}</span> <span class="v-small">{cityParts[0]}<span data-out="cityLoc">{cityForm(defCity)}</span>{cityParts[1]}</span></p>
        </div>
        <figure class="ix-mail">
          <figcaption class="v-list">{d.mailLabel}</figcaption>
          <p class="ix-mail-line" lang="pl">{mailParts[0]}<mark data-out="cityIn">{defCity.in}</mark>{mailParts[1]}</p>
          <p class="v-micro">{d.mailNote}</p>
        </figure>
        <div class="btn-row"><Btn href={sectorUrl(defSector)} outbound cta="registry-sector">{d.cta}</Btn></div>
      </div>
      <p class="src ix-src">{ui.source}: <a href={CEIDG.source} data-outbound data-cta="registry-source" rel="noopener">{d.source}</a></p>
    </div>
  </div>
  <script type="application/json" data-registry-data set:html={JSON.stringify(payload)} />
  <p class="map-label" data-map-label aria-hidden="true"><span class="map-label-in"><b data-label="name">{defCity.name}</b><span class="map-label-n"><span data-label="count">{fmt(defCity.count, lang)}</span> {dir.lookup.mapUnit}</span></span></p>
</section>

<style>
  .index { position: relative; padding-block: clamp(4rem, 10vh, 7rem); border-bottom: 2px solid var(--ink); }
  .ix-lead { margin-top: 1rem; }
  .ix-form { margin-top: 1.75rem; display: grid; gap: 1.5rem; }
  .ix-sectors, .ix-cities { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ix-cap { margin-bottom: 0.35rem; }
  .ix-list { columns: 1; column-gap: 1.5rem; column-rule: 1px solid var(--ink); border-top: 2px solid var(--ink); padding-top: 0.35rem; }
  @media (min-width: 560px) { .ix-list { columns: 2; } }
  .ix-list li { break-inside: avoid; }
  .ix-row { display: block; cursor: pointer; position: relative; }
  .ix-row input, .ix-tab input { position: absolute; opacity: 0; pointer-events: none; }
  .ix-row .ld { padding: 0.2rem 0.3rem; margin-inline: -0.3rem; font-size: 0.86rem; transition: background-color 0.12s, color 0.12s; }
  .ix-name { font-stretch: var(--w-list); font-weight: 750; text-transform: uppercase; letter-spacing: 0.02em; font-size: 0.8rem; }
  .ix-row:hover .ld { background: color-mix(in srgb, var(--ink) 10%, var(--yellow)); }
  .ix-row input:checked + .ld { background: var(--ink); color: var(--yellow); }
  .ix-row input:focus-visible + .ld { outline: 3px solid var(--ink); outline-offset: 2px; }

  .ix-cities legend { margin-bottom: 0.5rem; }
  .ix-tabs { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ix-tab span { display: inline-flex; align-items: center; min-height: 40px; padding: 0.3rem 0.65rem; border: 2px solid var(--ink); font-weight: 650; font-size: 0.88rem; cursor: pointer; transition: background-color 0.12s, color 0.12s; background: var(--yellow); }
  .ix-tab span:hover { background: color-mix(in srgb, var(--ink) 10%, var(--yellow)); }
  .ix-tab input:checked + span { background: var(--red); border-color: var(--red); color: #fff; }
  .ix-tab input:focus-visible + span { outline: 3px solid var(--ink); outline-offset: 2px; }

  /* the result: a directory page for your market */
  .ix-page { margin-top: 1.75rem; background: var(--white); border: var(--frame) solid var(--ink); padding: 0 1.1rem 1.2rem; --stock: var(--white); }
  .ix-rh { display: flex; justify-content: space-between; gap: 1rem; margin-inline: -1.1rem; padding: 0.45rem 1.1rem; background: var(--ink); color: var(--yellow); font-stretch: var(--w-list); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-micro); }
  .ix-counts { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-block: 1rem 0.9rem; border-bottom: 1px solid var(--ink); }
  .ix-count { display: grid; gap: 0.25rem; align-content: start; }
  .ix-n { font-stretch: var(--w-display); font-weight: 900; font-size: clamp(2.3rem, 1.6rem + 2vw, 3.4rem); line-height: 0.88; }
  .ix-count:first-child .ix-n { color: var(--red-deep); }
  .ix-mail { margin: 0.9rem 0 1.1rem; display: grid; gap: 0.45rem; }
  .ix-mail-line { font-size: 1.08rem; line-height: 1.45; font-weight: 500; }
  .ix-mail mark { background: none; color: inherit; box-shadow: inset 0 -0.42em 0 var(--yellow); padding-inline: 0.08em; }
  .ix-src { margin-top: 1rem; }
  @media (max-width: 480px) { .ix-counts { grid-template-columns: 1fr; } }

  /* the picked city's label on the live map: placed by the scene next to the city's ring */
  .map-label { position: fixed; left: 0; top: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 0.3s var(--ease); }
  .map-label[data-on] { opacity: 1; }
  /* a map callout: a short red leader from the ring, the name knocked out of the screen on the stock */
  .map-label-in { position: relative; display: grid; gap: 0.1rem; translate: 16px -50%; padding: 0.2rem 0.45rem 0.25rem; background: var(--yellow); font-stretch: var(--w-list); text-transform: uppercase; line-height: 1.05; white-space: nowrap; }
  .map-label-in::before { content: ''; position: absolute; top: 50%; left: -16px; width: 16px; height: 2px; background: var(--red); }
  .map-label.is-flip .map-label-in { translate: calc(-100% - 16px) -50%; text-align: right; }
  .map-label.is-flip .map-label-in::before { left: auto; right: -16px; }
  .map-label b { font-weight: 850; font-size: 1.05rem; letter-spacing: 0.03em; }
  .map-label-n { font-weight: 700; font-size: 0.74rem; letter-spacing: 0.05em; color: var(--red-deep); font-variant-numeric: tabular-nums; }
  @media (max-width: 959px) { .map-label { display: none; } }
</style>
