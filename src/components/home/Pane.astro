---
/** One screen of the OutreachPilot flow, printed as a form on white stock. Illustrative, labelled where it shows numbers. */
import type { Lang } from '../../content/site';
type Panel =
  | { kind: 'query'; query: string; result: string; detail: string; note: string }
  | { kind: 'declension'; pairs: string[][] }
  | { kind: 'log'; rows: string[]; status: string; limit: string; note: string }
  | { kind: 'replies'; rows: string[][] };
interface Props { lang: Lang; panel: Panel }
const { lang, panel } = Astro.props;
const pl = lang === 'pl';
---
<div class={`pane pane--${panel.kind}`}>
  {panel.kind === 'query' && (
    <>
      <p class="pane-q"><span class="pane-lab">{pl ? 'Szukaj' : 'Search'}</span><span class="pane-input" lang="pl">{panel.query}<i class="caret" aria-hidden="true"></i></span></p>
      <p class="pane-big num">{panel.result}</p>
      <p class="pane-sub">{panel.detail}</p>
      <div class="pane-bar"><span style="width:92%"></span></div>
      <p class="v-micro">{panel.note}</p>
    </>
  )}
  {panel.kind === 'declension' && (
    <ul class="pane-dec" lang="pl">
      {panel.pairs.map(([a, b]) => (
        <li class="ld"><span class="dec-a">{a}</span><i></i><span class="dec-b">{b}</span></li>
      ))}
    </ul>
  )}
  {panel.kind === 'log' && (
    <>
      <ul class="pane-log">
        {panel.rows.map((t) => <li><span class="num">{t}</span><span>{panel.status}</span><svg class="ok" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" /></svg></li>)}
      </ul>
      <p class="pane-lab">{panel.limit}</p>
      <div class="pane-bar"><span style="width:61%"></span></div>
      <p class="v-micro">{panel.note}</p>
    </>
  )}
  {panel.kind === 'replies' && (
    <ul class="pane-rep">
      {panel.rows.map(([who, tag, msg], i) => (
        <li><p><span class="rep-who">{who}</span><span class={`rep-tag rep-tag--${i}`}>{tag}</span></p><p class="rep-msg" lang={pl ? 'pl' : 'en'}>{msg}</p></li>
      ))}
    </ul>
  )}
</div>

<style>
  .pane { display: grid; gap: 0.85rem; color: var(--ink); }
  .pane-q { display: grid; gap: 0.35rem; }
  .pane-lab { font-stretch: var(--w-list); font-weight: 750; text-transform: uppercase; letter-spacing: 0.03em; font-size: var(--t-micro); }
  .pane-input { display: flex; align-items: center; min-height: 46px; padding: 0 0.8rem; border: 2px solid var(--ink); background: #fff; font-weight: 600; }
  .caret { width: 2px; height: 1.1em; background: var(--red); margin-left: 2px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .pane-big { font-stretch: var(--w-display); font-weight: 900; font-size: clamp(2.8rem, 2rem + 2.6vw, 4.2rem); line-height: 0.85; margin-top: 0.3rem; }
  .pane-sub { font-weight: 600; }
  .pane-bar { height: 6px; background: color-mix(in srgb, var(--ink) 12%, var(--white)); }
  .pane-bar span { display: block; height: 100%; background: var(--ink); }
  .pane-dec li { padding: 0.65rem 0; border-bottom: 1px solid var(--ink); font-size: 1.05rem; }
  .dec-a { color: var(--fg-2); }
  .dec-b { font-weight: 800; }
  .pane-log li { display: grid; grid-template-columns: 4rem 1fr 18px; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid var(--ink); }
  .pane-log .num { font-weight: 700; }
  .ok { width: 16px; height: 16px; color: var(--red-deep); }
  .pane-rep li { padding: 0.7rem 0; border-bottom: 1px solid var(--ink); display: grid; gap: 0.25rem; }
  .pane-rep p:first-child { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .rep-who { font-weight: 800; }
  .rep-tag { font-stretch: var(--w-list); font-weight: 750; text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.68rem; padding: 0.15rem 0.45rem; border: 2px solid var(--ink); }
  .rep-tag--0 { background: var(--red); border-color: var(--red); color: #fff; }
  .rep-msg { color: var(--fg-2); font-size: 0.95rem; }
</style>
