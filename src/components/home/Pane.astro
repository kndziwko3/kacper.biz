---
/** One "instrument" screen of the OutreachPilot flow. Illustrative UI, labelled as an example where it shows numbers. */
import type { Lang } from '../../content/site';
type Panel =
  | { kind: 'query'; query: string; result: string; detail: string; note: string }
  | { kind: 'declension'; pairs: string[][] }
  | { kind: 'log'; rows: string[]; status: string; limit: string; note: string }
  | { kind: 'replies'; rows: string[][] };
interface Props { lang: Lang; panel: Panel }
const { lang, panel } = Astro.props;
const pl = lang === 'pl';
---
<div class={`pane pane--${panel.kind}`}>
  {panel.kind === 'query' && (
    <>
      <p class="pane-q"><span class="data">{pl ? 'szukaj' : 'search'}</span><span class="pane-input" lang="pl">{panel.query}<i class="caret" aria-hidden="true"></i></span></p>
      <p class="pane-big num">{panel.result}</p>
      <p class="pane-sub">{panel.detail}</p>
      <div class="pane-bar"><span style="width:92%"></span></div>
      <p class="data pane-note">{panel.note}</p>
    </>
  )}
  {panel.kind === 'declension' && (
    <ul class="pane-dec" lang="pl">
      {panel.pairs.map(([a, b]) => (
        <li><span class="dec-a">{a}</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg><span class="dec-b">{b}</span></li>
      ))}
    </ul>
  )}
  {panel.kind === 'log' && (
    <>
      <ul class="pane-log">
        {panel.rows.map((t) => <li><span class="data num">{t}</span><span>{panel.status}</span><span class="ok" aria-hidden="true">✓</span></li>)}
      </ul>
      <p class="data pane-limit">{panel.limit}</p>
      <div class="pane-bar"><span style="width:61%"></span></div>
      <p class="data pane-note">{panel.note}</p>
    </>
  )}
  {panel.kind === 'replies' && (
    <ul class="pane-rep">
      {panel.rows.map(([who, tag, msg], i) => (
        <li><p><span class="rep-who">{who}</span><span class={`rep-tag rep-tag--${i}`}>{tag}</span></p><p class="rep-msg" lang={pl ? 'pl' : 'en'}>{msg}</p></li>
      ))}
    </ul>
  )}
</div>

<style>
  .pane { display: grid; gap: 0.9rem; }
  .pane-q { display: grid; gap: 0.4rem; }
  .pane-input { display: flex; align-items: center; min-height: 48px; padding: 0 0.9rem; border: 1px solid var(--line-2); border-radius: 3px; font-family: var(--f-mono); font-size: 0.85rem; }
  .caret { width: 1px; height: 1.1em; background: var(--signal); margin-left: 2px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .pane-big { font-family: var(--f-display); font-weight: 750; font-stretch: 85%; font-size: clamp(2.6rem, 2rem + 2.4vw, 4rem); letter-spacing: -0.04em; line-height: 1; margin-top: 0.4rem; }
  .pane-sub { color: var(--mute); }
  .pane-bar { height: 3px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .pane-bar span { display: block; height: 100%; background: var(--signal); }
  .pane-note { color: var(--faint); }
  .pane-dec { display: grid; gap: 0; }
  .pane-dec li { display: grid; grid-template-columns: 1fr 20px 1.3fr; align-items: center; gap: 0.8rem; padding: 0.8rem 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
  .pane-dec svg { width: 16px; height: 16px; color: var(--faint); }
  .dec-a { color: var(--mute); }
  .dec-b { font-weight: 600; }
  .pane-log li { display: grid; grid-template-columns: 4.5rem 1fr auto; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .pane-log .ok { color: var(--signal); }
  .pane-limit { margin-top: 0.4rem; }
  .pane-rep li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); display: grid; gap: 0.3rem; }
  .pane-rep p:first-child { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .rep-who { font-weight: 600; }
  .rep-tag { font-family: var(--f-mono); font-size: 0.7rem; padding: 0.2rem 0.5rem; border: 1px solid var(--line-2); border-radius: 2px; color: var(--mute); }
  .rep-tag--0 { border-color: var(--signal); color: var(--signal); }
  .rep-msg { color: var(--mute); font-size: 0.95rem; }
</style>
