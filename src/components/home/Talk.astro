---
import ContactForm from '../ContactForm.astro';
import { copy } from '../../content/copy';
import { CONTACT, SALES, type Lang } from '../../content/site';
interface Props { lang: Lang; heading?: boolean; idPrefix?: string }
const { lang, heading = true, idPrefix = 'home' } = Astro.props;
const t = copy[lang].home.talk;
const ui = copy[lang].ui;
---
<section id="kontakt" class="talk m-window" data-scene="5" data-scene-side="center" data-scene-dim="0.3" aria-labelledby={heading ? 'talk-h' : undefined} aria-label={heading ? undefined : t.label}>
  <div class="wrap">
    {heading && (
      <div class="m-solid">
        <p class="label"><b>{t.label}</b></p>
        <h2 class="h2 talk-h" id="talk-h" data-lines>{t.h2}</h2>
      </div>
    )}
    <div class="grid talk-grid m-solid">
      <div class="c-1-5 justyna">
        <div class="jl">
          <span class="jl-mono" aria-hidden="true">{SALES.initials}</span>
          <div><p class="h3">{SALES.fullName}</p><p class="data">{t.justyna.role}</p></div>
        </div>
        <p class="body jl-p">{t.justyna.p}</p>
        <p class="data jl-pick">{t.justyna.pick}</p>
        <ul class="days" data-days data-url={SALES.bookingUrl} data-lang={lang}></ul>
        <a class="jl-full link link--u" href={SALES.bookingUrl} target="_blank" rel="noopener" data-cta="talk-calendar">{t.justyna.full}<span class="sr-only"> {ui.newTab}</span></a>
      </div>
      <div class="c-7-12 write">
        {heading ? <h3 class="h3">{t.write.h3}</h3> : <h2 class="h3">{t.write.h3}</h2>}
        <p class="body write-p">{t.write.p}</p>
        <ContactForm lang={lang} idPrefix={idPrefix} />
      </div>
    </div>
    <div class="grid talk-foot m-solid">
      <p class="note c-1-5"><a class="link" href={CONTACT.aiPhone.href}>{t.phone}</a></p>
      <p class="note c-7-12 talk-mails">
        <span>{t.emails.studio}: <a class="link link--u" href={`mailto:${CONTACT.studioEmail}`}>{CONTACT.studioEmail}</a></span>
        <span>{t.emails.product}: <a class="link link--u" href={`mailto:${CONTACT.productEmail}`}>{CONTACT.productEmail}</a></span>
      </p>
    </div>
  </div>
</section>

<style>
  .talk { position: relative; padding-block: clamp(6rem, 16vh, 10rem) clamp(5rem, 12vh, 8rem); }
  .talk-h { margin-top: 1.5rem; font-size: clamp(2.6rem, 1.3rem + 5.2vw, 6.4rem); max-width: 13ch; }
  .talk-grid { margin-top: clamp(3rem, 8vh, 5rem); row-gap: 4rem; align-items: start; }
  .jl { display: flex; align-items: center; gap: 1rem; }
  .jl-mono { width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--line-2); display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; font-stretch: 110%; letter-spacing: -0.02em; }
  .jl-p { margin-top: 1.25rem; }
  .jl-pick { margin-top: 1.75rem; }
  .days { margin-top: 0.75rem; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; }
  .days:empty { display: none; }
  .jl-full { display: inline-block; margin-top: 1.1rem; font-size: 0.95rem; }
  .write-p { margin: 0.6rem 0 1.75rem; }
  .talk-foot { margin-top: clamp(3.5rem, 9vh, 5rem); padding-top: 1.25rem; border-top: 1px solid var(--line); row-gap: 1rem; }
  .talk-mails { display: grid; gap: 0.4rem; }
  @media (max-width: 899px) { .talk .m-solid:first-child { padding-top: 1rem; } }
</style>
<style is:global>
  .days a { display: grid; gap: 0.1rem; justify-items: center; padding: 0.7rem 0.3rem; border: 1px solid var(--line-2); border-radius: 3px; transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .days a:hover { border-color: var(--signal); background: rgb(255 90 31 / 0.08); }
  .days .d-w { font-family: var(--f-mono); font-size: 0.68rem; color: var(--mute); }
  .days .d-n { font-family: var(--f-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.03em; line-height: 1.1; }
  .days .d-m { font-family: var(--f-mono); font-size: 0.68rem; color: var(--mute); }
</style>
