---
/** The rate card: one-off prices and monthly services as directory lines, net, with the date they were read. */
import { copy } from '../../content/copy';
import { FASTLANDING_OFFERS, FASTLANDING_RECURRING, type Lang } from '../../content/site';
import { typo } from '../../lib/typo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = copy[lang].home.fl.prices;
const d = copy[lang].dir.fl;
const price = (o: { price: string; priceEn: string }) => typo(lang === 'pl' ? o.price : o.priceEn, lang);
---
<div class="rates">
  <h3 class="v-list rates-h">{p.h3}</h3>
  <p class="v-micro rates-sub">{d.rateOnce}</p>
  <ul class="rates-list">
    {FASTLANDING_OFFERS.map((o) => (
      <li><span class="ld"><b>{o.name[lang]}</b><i></i><span class="rates-p" set:html={price(o)} /></span><span class="v-micro" set:html={typo(o.time[lang], lang)} /></li>
    ))}
  </ul>
  <p class="v-micro rates-sub">{p.recurring}</p>
  <ul class="rates-list">
    {FASTLANDING_RECURRING.map((o) => (
      <li><span class="ld"><b>{o.name[lang]}</b><i></i><span class="rates-p" set:html={price(o)} /></span></li>
    ))}
  </ul>
  <p class="src rates-note">{p.note}</p>
</div>
<style>
  .rates-h { padding-bottom: 0.4rem; border-bottom: 8px solid var(--ink); }
  .rates-sub { margin-top: 0.9rem; font-weight: 700; color: var(--fg-2); text-transform: uppercase; letter-spacing: 0.04em; }
  .rates-list li { display: grid; gap: 0.05rem; padding-block: 0.5rem; border-bottom: 1px solid var(--ink); }
  .rates-list b { font-weight: 750; }
  .rates-p { font-weight: 850; }
  .rates-note { margin-top: 0.9rem; }
</style>
