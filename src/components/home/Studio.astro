---
/**
 * FastLanding.io, on white stock: the boxed ad grew into a website. Proof sheet of client sites, the rate card,
 * what goes into the contract, the five steps, and the order line.
 */
import Btn from '../ui/Btn.astro';
import Showcase from './Showcase.astro';
import Prices from './Prices.astro';
import Clauses from './Clauses.astro';
import Process from './Process.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, SALES, type Lang } from '../../content/site';
interface Props { lang: Lang; heading?: boolean }
const { lang, heading = true } = Astro.props;
const c = copy[lang];
const f = c.home.fl;
const d = c.dir.fl;
---
<section id="fastlanding" class="studio stock-white" data-guide={c.dir.guide.fl} data-scene-occlude aria-labelledby={heading ? 'fl-h' : undefined} aria-label={heading ? undefined : d.cat}>
  <div class="wrap">
    {heading && (
      <div class="grid studio-head">
        <div class="cat c-1-12"><h2 class="v-cat" id="fl-h">{d.cat}</h2></div>
        <p class="v-state c-1-8 studio-state">{d.lead}</p>
        <p class="v-lead c-9-12 studio-p">{f.p}</p>
      </div>
    )}

    {!heading && <h2 class="sr-only">{d.cat}</h2>}
    <Showcase lang={lang} />

    <div class="grid studio-terms">
      <div class="c-1-6"><Prices lang={lang} /></div>
      <div class="c-7-12"><Clauses lang={lang} /></div>
    </div>

    <div class="studio-process"><Process lang={lang} /></div>

    <div class="grid studio-close">
      <div class="c-1-6">
        <h3 class="v-head">{f.ai.h3}</h3>
        <p class="v-body studio-ai">{f.ai.p}</p>
      </div>
      <article class="ad stock-yellow c-7-12 studio-ad" aria-labelledby="fl-ad-h">
        <p class="ad-domain">FastLanding.io</p>
        <h3 class="ad-h" id="fl-ad-h">{c.fl.cta.h2}</h3>
        <div class="ad-foot">
          <span class="sticker">{c.dir.entry.adFl.price} <small>{c.dir.entry.adFl.priceNote}</small></span>
          <div class="btn-row">
            <Btn href={PRODUCTS.fastlanding.quote} outbound cta="fl-quote">{f.cta}</Btn>
            <Btn href={SALES.bookingUrl} variant="line" outbound cta="fl-booking">{f.ctaAlt}</Btn>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .studio { padding-block: clamp(4rem, 10vh, 7rem); border-bottom: 2px solid var(--ink); }
  .studio-head { margin-bottom: clamp(2.5rem, 6vh, 4rem); }
  .studio-state { margin-top: 1.25rem; }
  .studio-p { margin-top: 1.25rem; color: var(--fg-2); }
  @media (min-width: 960px) { .studio-p { align-self: end; } }
  .studio-terms { margin-top: clamp(3.5rem, 9vh, 6rem); row-gap: 3rem; }
  .studio-process { margin-top: clamp(3.5rem, 9vh, 6rem); }
  .studio-close { margin-top: clamp(3.5rem, 9vh, 6rem); row-gap: 2rem; align-items: start; }
  .studio-ai { margin-top: 0.75rem; }
  .studio-ad { --rule: var(--ink); }
</style>
