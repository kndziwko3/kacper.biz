---
import { PROOF, type Lang } from '../content/site';
interface Props { lang: Lang; label: string }
const { lang, label } = Astro.props;
const countable = (v: string) => /^[\d\s]+(\s\D+)?$/.test(v);
---
<div class="proof" role="group" aria-label={label} data-reveal>
  {PROOF.map((p, i) => (
    <a href={p.href} data-outbound data-cta={`proof-${i + 1}`} rel="noopener">
      <span class="proof__v" data-count={countable(p.value) ? '' : undefined}>{p.value}</span>
      <span class="proof__l">{p.label[lang]}</span>
    </a>
  ))}
</div>
