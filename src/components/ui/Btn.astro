---
/** A key: the copper cap for the one primary action on a screen, a hairline ghost cap for the second. */
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  /** external links get UTM tagging (data-outbound) */
  cta?: string;
  outbound?: boolean;
  newTab?: boolean;
  class?: string;
}
const { href, variant = 'solid', cta, outbound = false, newTab = false, class: cls = '' } = Astro.props;
---
<a
  class:list={['btn', variant === 'ghost' && 'btn--ghost', cls]}
  href={href}
  data-outbound={outbound ? '' : undefined}
  data-cta={cta}
  rel={outbound || newTab ? 'noopener' : undefined}
  target={newTab ? '_blank' : undefined}
><slot /></a>
