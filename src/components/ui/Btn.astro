---
/** An order slip: black (or red) printed block, no radius, no arrow. External links name their domain in the copy. */
interface Props {
  href: string;
  variant?: 'solid' | 'line' | 'red';
  /** external links get UTM tagging (data-outbound) */
  cta?: string;
  outbound?: boolean;
  newTab?: boolean;
  class?: string;
}
const { href, variant = 'solid', cta, outbound = false, newTab = false, class: cls = '' } = Astro.props;
---
<a
  class:list={['btn', variant === 'line' && 'btn--line', variant === 'red' && 'btn--red', cls]}
  href={href}
  data-outbound={outbound ? '' : undefined}
  data-cta={cta}
  rel={outbound || newTab ? 'noopener' : undefined}
  target={newTab ? '_blank' : undefined}
><slot /></a>
