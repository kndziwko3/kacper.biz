---
/**
 * Subpage opener: one viewport of the studio. The film holds this route's pose (data-film-pose, read by
 * src/film/film.ts) and the still of that pose stands in until it runs. The H1, the lead, the actions, the breadcrumb.
 */
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';
interface Props {
  lang: Lang; crumb: string; h1: string; lead?: string;
  pose: number; still?: string; guide?: string; stillPos?: string; short?: boolean;
}
const { lang, crumb, h1, lead, pose, still = `p${pose}`, guide, stillPos, short = false } = Astro.props;
const home = lang === 'pl' ? '/' : '/en';
---
<section class:list={['ph', short && 'ph--short']} data-film-pose={pose} data-guide={guide ?? crumb} aria-labelledby="page-h1" style={stillPos ? `--still-pos:${stillPos}` : undefined}>
  <div class="still" aria-hidden="true">
    <picture>
      <source media="(min-width: 960px)" srcset={`/stills/${still}-d.webp`} width="1600" height="1000" />
      <img src={`/stills/${still}-m.webp`} alt="" width="780" height="1688" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
  </div>
  <div class="wrap grid ph-grid">
    <div class="ph-in">
      <h1 class="t-display ph-h1" id="page-h1">{h1}</h1>
      {lead && <p class="t-lead dim ph-lead">{lead}</p>}
      {Astro.slots.has('default') && <div class="btn-row ph-actions"><slot /></div>}
      <nav class="t-small ph-crumbs" aria-label={lang === 'pl' ? 'Ścieżka nawigacji' : 'Breadcrumb'}><a class="tlink" href={home}>{copy[lang].ui.home}</a><span aria-hidden="true">/</span><span aria-current="page">{crumb}</span></nav>
    </div>
  </div>
</section>
<style>
  .ph { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: clip; }
  .ph--short { min-height: min(78svh, 52rem); }
  .ph-grid { padding-top: calc(var(--head-h) + 2rem); padding-bottom: clamp(3rem, 9svh, 6rem); }
  .ph-in { display: grid; gap: 1.35rem; justify-items: start; }
  .ph-crumbs { display: flex; gap: 0.5rem; color: var(--text-2); margin-top: 0.75rem; }
  .ph-h1 { max-width: 16ch; }
  .ph-lead { max-width: 44ch; }
  .ph-actions { margin-top: 0.75rem; }
  @media (min-width: 960px) { .ph-in { grid-column: 1 / 8; } }
  @media (max-width: 959px) { .ph:not(.ph--short) .ph-grid { padding-top: 50svh; } }
  @media (max-width: 959px) and (max-height: 520px) and (orientation: landscape) { .ph:not(.ph--short) .ph-grid { padding-top: calc(var(--head-h) + 1rem); } .ph { min-height: 100svh; } .ph-h1 { font-size: clamp(1.6rem, 0.4rem + 8vh, 2.6rem); } }
</style>
