---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Talk from '../home/Talk.astro';
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const k = c.contact;
const isPl = lang === 'pl';
const path = isPl ? '/kontakt' : '/en/contact';
const home = isPl ? '/' : '/en';
---
<Base lang={lang} path={path} title={k.title} description={k.description} kind="contact"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: k.crumb, path }]} ogImage={isPl ? '/og/contact.png' : '/og/contact-en.png'}>
  <PageHead lang={lang} crumb={k.crumb} kicker={k.kicker} h1={k.h1} lead={k.lead} scene={5} side="left" />
  <Talk lang={lang} heading={false} idPrefix="contact" />
</Base>
