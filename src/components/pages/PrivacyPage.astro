---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import { copy, formatDate } from '../../content/copy';
import { SITE, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const p = c.privacy;
const isPl = lang === 'pl';
const path = isPl ? '/polityka-prywatnosci' : '/en/privacy';
const home = isPl ? '/' : '/en';
---
<Base lang={lang} path={path} title={p.title} description={p.description} kind="legal" guide={c.dir.guide.privacy}
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: p.crumb, path }]}>
  <PageHead lang={lang} crumb={p.crumb} h1={p.h1} lead={`${c.ui.updated}: ${formatDate(lang, SITE.lastModified)}`} stock="white" guide={c.dir.guide.privacy} />
  <section class="priv stock-white" data-scene-occlude>
    <div class="wrap">
      <div class="prose">
        {p.sections.map((s) => (<>
          <h2>{s.h}</h2>
          {s.p.map((t) => <p>{t}</p>)}
        </>))}
      </div>
    </div>
  </section>
</Base>
<style>
  .priv { padding-block: 1rem clamp(4rem, 10vh, 6rem); border-bottom: 2px solid var(--ink); }
</style>
