---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import { copy, formatDate } from '../../content/copy';
import { SITE, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const p = c.privacy;
const isPl = lang === 'pl';
const path = isPl ? '/polityka-prywatnosci' : '/en/privacy';
const home = isPl ? '/' : '/en';
---
<Base lang={lang} path={path} title={p.title} description={p.description} kind="legal"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: p.crumb, path }]}>
  <PageHead lang={lang} crumb={p.crumb} kicker={`${c.ui.updated}: ${formatDate(lang, SITE.lastModified)}`} h1={p.h1} scene={1} side="left" dim={0.4} />
  <section class="section m-window" data-scene="1" data-scene-side="right" data-scene-dim="0.3">
    <div class="wrap m-solid">
      <div class="prose">
        {p.sections.map((s) => (<>
          <h2>{s.h}</h2>
          {s.p.map((t) => <p>{t}</p>)}
        </>))}
      </div>
    </div>
  </section>
</Base>
