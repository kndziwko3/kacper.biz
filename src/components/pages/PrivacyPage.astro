---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { copy, formatDate } from '../../content/copy';
import { SITE, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const p = c.privacy;
const isPl = lang === 'pl';
const path = isPl ? '/polityka-prywatnosci' : '/en/privacy';
const home = isPl ? '/' : '/en';
---
<Base lang={lang} path={path} title={p.title} description={p.description} kind="legal" scene={false}
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: p.crumb, path }]}>
  <section class="page-hero"><div class="wrap">
    <Breadcrumb lang={lang} current={p.crumb} />
    <h1 class="display" style="font-size:clamp(2.4rem,1rem + 5vw,5rem)">{p.h1}</h1>
    <p class="muted" style="margin-top:1rem">{c.ui.updated}: <time datetime={SITE.lastModified}>{formatDate(lang)}</time></p>
  </div></section>
  <section class="section" style="padding-top:0"><div class="wrap">
    <div class="prose">
      {p.sections.map((s) => (<>
        <h2>{s.h}</h2>
        {s.p.map((t) => <p>{t}</p>)}
      </>))}
    </div>
  </div></section>
</Base>
