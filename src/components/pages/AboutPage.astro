---
/** About: who I am, the facts as rows, where else to find me and the namesake note. */
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Sheet from '../ui/Sheet.astro';
import Btn from '../ui/Btn.astro';
import Faq from '../Faq.astro';
import { copy, formatDate } from '../../content/copy';
import { PERSON, PRODUCTS, SITE, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const a = c.about;
const isPl = lang === 'pl';
const path = isPl ? '/o-mnie' : '/en/about';
const home = isPl ? '/' : '/en';
const contact = isPl ? '/kontakt' : '/en/contact';
const finds = [
  { label: 'LinkedIn', href: PERSON.linkedin, rel: 'me noopener', note: 'linkedin.com' },
  { label: isPl ? 'OutreachPilot.pl, o redakcji i autorze' : 'OutreachPilot.pl, editorial and author page', href: PRODUCTS.outreachpilot.about, rel: 'noopener', note: 'outreachpilot.pl/o-redakcji' },
  { label: isPl ? 'FastLanding.io, o nas' : 'FastLanding.io, about', href: PRODUCTS.fastlanding.about, rel: 'noopener', note: 'fastlanding.io/o-nas' },
];
const faq = [c.faq[0]!, c.faq[5]!];
---
<Base lang={lang} path={path} title={a.title} description={a.description} kind="about" ogType="profile"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: a.crumb, path }]} faq={faq}
  ogImage={isPl ? '/og/about.png' : '/og/about-en.png'} still="p4">
  <PageHead lang={lang} crumb={a.crumb} h1={a.h1} lead={a.lead} pose={4} guide={c.film.guide.about}>
    <Btn href={contact}>{c.ui.write}</Btn>
  </PageHead>

  <Sheet id="fakty" labelledby="facts-h" guide={a.facts.h2}>
    <div class="grid pg-two">
      <div class="pg-main about-body">
        {a.body.map((p, i) => <p class:list={[i === 0 ? 't-h3' : 't-lead dim']}>{p}</p>)}
      </div>
      <div class="pg-side">
        <h2 class="t-label dim" id="facts-h">{a.facts.h2}</h2>
        <dl class="rows about-facts">
          {a.facts.rows.map(([k, v]) => <div><dt class="t-label dim">{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <p class="t-src">{c.ui.updated}: <time datetime={SITE.lastModified}>{formatDate(lang)}</time></p>

        <h2 class="t-label dim about-h">{a.find.h2}</h2>
        <ul class="rows">
          {finds.map((f) => <li><a class="k tlink" href={f.href} rel={f.rel} target="_blank">{f.label}</a><span class="v t-label dim">{f.note}</span></li>)}
        </ul>

        <h2 class="t-label dim about-h">{a.disambig.h2}</h2>
        <p class="t-small dim">{a.disambig.p}</p>
      </div>
    </div>
  </Sheet>

  <Faq lang={lang} items={faq} />
</Base>
<style>
  .about-body { gap: 1.75rem; }
  .about-facts > div { grid-template-columns: 1fr; gap: 0.3rem; }
  .about-facts dd { text-align: left; }
  .about-h { margin-top: 2rem; }
  @media (min-width: 700px) { .about-facts > div { grid-template-columns: 9.5rem 1fr; align-items: baseline; } }
</style>
