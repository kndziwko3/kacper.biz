---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Sheet from '../ui/Sheet.astro';
import Btn from '../ui/Btn.astro';
import OpSheet from '../film/OpSheet.astro';
import Faq from '../Faq.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const o = c.op;
const steps = c.home.op.steps;
const isPl = lang === 'pl';
const path = isPl ? '/outreachpilot' : '/en/outreachpilot';
const home = isPl ? '/' : '/en';
const faq = [c.faq[1]!, c.faq[4]!, c.faq[5]!];
---
<Base lang={lang} path={path} title={o.title} description={o.description} kind="product"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: o.crumb, path }]} faq={faq}
  ogImage={isPl ? '/og/outreachpilot.png' : '/og/outreachpilot-en.png'} still="p2">
  <PageHead lang={lang} crumb={o.crumb} h1={o.h1} lead={o.lead} pose={1} guide="OutreachPilot.pl">
    <Btn href={PRODUCTS.outreachpilot.signup} outbound cta="op-page-signup">{c.home.op.cta}</Btn>
    <Btn href={PRODUCTS.outreachpilot.url} variant="ghost" outbound cta="op-page-site">outreachpilot.pl</Btn>
  </PageHead>

  <Sheet id="co-to-jest" labelledby="op-what" guide={o.what.h2}>
    <div class="grid pg-two">
      <div class="pg-main">
        <h2 class="t-h2" id="op-what">{o.what.h2}</h2>
        <p class="t-lead">{o.what.p1}</p>
        <p class="t-body dim">{o.what.p2}</p>
      </div>
      <div class="pg-side">
        <h3 class="t-label dim">{o.forWho.h2}</h3>
        <ul class="rows">
          {o.forWho.items.map(([label, href]) => <li><a class="k tlink" href={href} data-outbound data-cta="op-vertical" rel="noopener">{label}</a><span class="v t-label dim">{href.replace('https://', '')}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="pg-block">
      <h2 class="t-h2">{c.home.op.h2}</h2>
      <ol class="pg-steps">
        {steps.map((s, i) => (<li><span class="pg-n num" aria-hidden="true">{i + 1}</span><b class="t-h3">{s.title}</b><span class="t-small dim">{s.text}</span></li>))}
      </ol>
    </div>
  </Sheet>

  <OpSheet lang={lang} id="panel" />

  <Sheet id="mcp" labelledby="op-mcp" guide="MCP">
    <div class="grid pg-two pg-rule">
      <div class="pg-main">
        <h2 class="t-h2" id="op-mcp">{o.mcp.h2}</h2>
        <p class="t-body dim">{o.mcp.p} <a class="tlink" href={PRODUCTS.outreachpilot.mcp} data-outbound data-cta="op-mcp-page" rel="noopener">{o.mcp.link}</a></p>
      </div>
      <div class="pg-side">
        <h2 class="t-h3">{o.disambig.h2}</h2>
        <p class="t-body dim">{o.disambig.p}</p>
      </div>
    </div>
  </Sheet>

  <Faq lang={lang} items={faq} />
</Base>
