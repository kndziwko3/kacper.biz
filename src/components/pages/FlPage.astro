---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Btn from '../ui/Btn.astro';
import Studio from '../home/Studio.astro';
import Bot from '../home/Bot.astro';
import Faq from '../Faq.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, SALES, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const f = c.fl;
const isPl = lang === 'pl';
const path = isPl ? '/fastlanding' : '/en/fastlanding';
const home = isPl ? '/' : '/en';
const faq = [c.faq[2]!, c.faq[3]!];
---
<Base lang={lang} path={path} title={f.title} description={f.description} kind="product"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: f.crumb, path }]} faq={faq}
  ogImage={isPl ? '/og/fastlanding.png' : '/og/fastlanding-en.png'}>
  <PageHead lang={lang} crumb={f.crumb} kicker={f.kicker} h1={f.h1} lead={f.lead} scene={3} side="left">
    <Btn href={PRODUCTS.fastlanding.quote} outbound cta="fl-page-quote" arrow="up">{c.home.fl.cta}</Btn>
    <Btn href={SALES.bookingUrl} variant="line" newTab cta="fl-page-booking" arrow="up">{c.home.fl.ctaAlt}</Btn>
  </PageHead>
  <Studio lang={lang} />
  <Bot lang={lang} />
  <Faq lang={lang} items={faq} />
  <section class="section m-window" data-scene="5" data-scene-side="center" data-scene-dim="0.5">
    <div class="wrap m-solid">
      <h2 class="h2 fl-cta-h" data-lines>{f.cta.h2}</h2>
      <p class="data fl-usuk">{f.usUk} <a class="link link--u" href={PRODUCTS.fastlanding.us} data-outbound data-cta="fl-us" rel="noopener">fastlanding.io/us</a> · <a class="link link--u" href={PRODUCTS.fastlanding.uk} data-outbound data-cta="fl-uk" rel="noopener">fastlanding.io/uk</a></p>
      <div class="btn-row fl-cta">
        <Btn href={PRODUCTS.fastlanding.quote} outbound cta="fl-page-bottom" arrow="up">{f.cta.btn}</Btn>
        <Btn href={SALES.bookingUrl} variant="line" newTab cta="fl-page-booking-2" arrow="up">{f.cta.alt}</Btn>
      </div>
    </div>
  </section>
</Base>
<style>
  .fl-cta-h { max-width: 16ch; }
  .fl-usuk { margin-top: 1.25rem; }
  .fl-cta { margin-top: 2rem; }
</style>
