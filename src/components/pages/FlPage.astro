---
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Btn from '../ui/Btn.astro';
import FlSheet from '../film/FlSheet.astro';
import BotSheet from '../film/BotSheet.astro';
import Faq from '../Faq.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, SALES, type Lang } from '../../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const f = c.fl;
const isPl = lang === 'pl';
const path = isPl ? '/fastlanding' : '/en/fastlanding';
const home = isPl ? '/' : '/en';
const faq = [c.faq[6]!, c.faq[2]!, c.faq[7]!, c.faq[3]!];
---
<Base lang={lang} path={path} title={f.title} description={f.description} kind="product"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: f.crumb, path }]} faq={faq}
  ogImage={isPl ? '/og/fastlanding.png' : '/og/fastlanding-en.png'} still="p3">
  <PageHead lang={lang} crumb={f.crumb} h1={f.h1} lead={f.lead} pose={3} guide="FastLanding.io">
    <Btn href={PRODUCTS.fastlanding.quote} outbound cta="fl-page-quote">{c.home.fl.cta}</Btn>
    <Btn href={SALES.bookingUrl} variant="ghost" outbound cta="fl-page-booking">{c.home.fl.ctaAlt}</Btn>
  </PageHead>
  <FlSheet lang={lang}>
    <p class="t-src fl-usuk">{f.usUk} <a class="tlink" href={PRODUCTS.fastlanding.us} data-outbound data-cta="fl-us" rel="noopener">fastlanding.io/us</a>, <a class="tlink" href={PRODUCTS.fastlanding.uk} data-outbound data-cta="fl-uk" rel="noopener">fastlanding.io/uk</a></p>
  </FlSheet>
  <BotSheet lang={lang} />
  <Faq lang={lang} items={faq} />
</Base>
<style>
  .fl-usuk { margin-top: 3rem; }
</style>
