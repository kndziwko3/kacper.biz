---
/**
 * The home page is one film: five chapters (the monolith, the rotunda, the drawer, the exploded page, the monolith
 * again) with the evidence sheets laid over it between them. See src/film/film.ts for the poses.
 */
import Base from '../../layouts/Base.astro';
import Chapter from '../ui/Chapter.astro';
import Btn from '../ui/Btn.astro';
import OpSheet from '../film/OpSheet.astro';
import FlSheet from '../film/FlSheet.astro';
import BotSheet from '../film/BotSheet.astro';
import ContactSheet from '../film/ContactSheet.astro';
import Faq from '../Faq.astro';
import Rail from '../film/Rail.astro';
import { copy } from '../../content/copy';
import { SALES, type Lang } from '../../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const h = c.home;
const f = c.film;
const isPl = lang === 'pl';
const ch = f.chapters;
// the product chapters set the product's name as the display line and the promise under it
const split = (t: string) => { const i = t.indexOf(': '); return i > 0 ? [t.slice(0, i), t.slice(i + 2)] : [t, '']; };
const [opName, opLine] = split(f.op.h2);
const [flName, flLine] = split(f.fl.h2);
const up = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const rail = [['start', ch[0]], ['trzy', ch[1]], ['film-op', ch[2]], ['film-fl', ch[3]], ['film-kontakt', ch[4]]].map(([id, name]) => ({ id: id!, name: name! }));
---
<Base lang={lang} path={isPl ? '/' : '/en'} title={h.title} description={h.description} kind="home" faq={c.faq} ogImage={isPl ? '/og/home.png' : '/og/home-en.png'} still="p0">
  <Chapter pose={0} still="p0" first eager len={190} lenM={150} guide={ch[0]} labelledby="hero-h" id="start">
    <div class="hero">
      <h1 class="t-name hero-name" id="hero-h"><span>Kacper</span> <span>Rękawek</span></h1>
      <p class="t-lead hero-offer">{f.hero.role}, {f.hero.place}</p>
    </div>
  </Chapter>

  <Chapter pose={1} still="p1" len={250} lenM={200} guide={ch[1]} labelledby="three-h" id="trzy">
    <h2 class="t-display reveal" id="three-h">{f.three.h2}</h2>
    <p class="t-lead dim measure">{f.three.p}</p>
    <p class="t-src">{h.thesis.source}</p>
  </Chapter>

  <Chapter pose={2} still="p2" side="right" len={300} lenM={240} guide={ch[2]} labelledby="op-ch-h" id="film-op">
    <h2 class="t-display reveal" id="op-ch-h">{opName}</h2>
    <p class="t-lead">{up(opLine)}</p>
    <ol class="beats">
      {f.op.beats.map(([t, d], i) => (<li class="beat"><span class="t-label beat-n num" aria-hidden="true">{i + 1}</span><b class="t-h3">{t}</b><span class="t-small dim">{d}</span></li>))}
    </ol>
  </Chapter>

  <OpSheet lang={lang} />

  <Chapter pose={3} still="p3" len={300} lenM={240} guide={ch[3]} labelledby="fl-ch-h" id="film-fl">
    <h2 class="t-display reveal" id="fl-ch-h">{flName}</h2>
    <p class="t-lead">{up(flLine)}</p>
    <ul class="beats beats--plain">
      {f.fl.beats.map(([t, d]) => (<li class="beat"><b class="t-h3">{t}</b><span class="t-small dim">{d}</span></li>))}
    </ul>
  </Chapter>

  <FlSheet lang={lang} />
  <BotSheet lang={lang} />

  <Chapter pose={4} still="p4" side="right" last len={220} lenM={180} guide={ch[4]} labelledby="close-h" id="film-kontakt">
    <h2 class="t-display reveal" id="close-h">{f.close.h2}</h2>
    <p class="t-lead dim measure">{f.close.p}</p>
    <div class="btn-row"><Btn href={SALES.bookingUrl} outbound cta="close-booking">{f.close.cta}</Btn></div>
  </Chapter>

  <ContactSheet lang={lang} />
  <Faq lang={lang} />
  <Rail chapters={rail} label={isPl ? 'Rozdziały' : 'Chapters'} />
</Base>

<style>
  .hero { display: grid; gap: 1.5rem; }
  .hero-name { display: grid; margin-left: -0.05em; }
  .hero-name span { display: block; }
  .hero-offer { max-width: 32ch; }
  @media (min-width: 960px) { .hero-offer { max-width: none; } }
  /* the name is the widest thing on the page: it runs past the copy column, under the object's shoulder */
  @media (min-width: 960px) { :global(.ch--first .copy) { grid-column: 1 / 11; } }
  .beats { display: grid; border-top: 1px solid var(--line-d); margin-top: 0.5rem; }
  .beat { display: grid; grid-template-columns: 2rem 1fr; column-gap: 1rem; row-gap: 0.35rem; padding-block: 1rem; border-bottom: 1px solid var(--line-d); }
  .beat > :not(.beat-n) { grid-column: 2; }
  .beat-n { grid-row: span 2; padding-top: 0.4rem; color: var(--copper-hi); }
  .beats--plain .beat { grid-template-columns: 1fr; }
  .beats--plain .beat > * { grid-column: 1; }
  @media (max-width: 759px) { .beat .t-small { display: none; } .beat { padding-block: 0.7rem; } }
  /* short desktop windows: the pinned copy must still clear the rail */
  @media (min-width: 960px) and (max-height: 760px) {
    :global(.ch .t-display) { font-size: clamp(2.1rem, 0.9rem + 3.1vw, 3.8rem); }
    .beat .t-small { display: none; }
    .beat { padding-block: 0.6rem; }
    :global(.ch .t-lead) { font-size: 1.05rem; }
  }
  /* room at the foot of each stage for the chapter rail */
  :global(.ch .stage-in) { padding-bottom: calc(clamp(2.5rem, 7svh, 5.5rem) + 4.5rem); }
</style>
