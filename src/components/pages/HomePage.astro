---
import Base from '../../layouts/Base.astro';
import Hero from '../home/Hero.astro';
import Thesis from '../home/Thesis.astro';
import Registry from '../home/Registry.astro';
import Outreach from '../home/Outreach.astro';
import Studio from '../home/Studio.astro';
import Bot from '../home/Bot.astro';
import Faq from '../Faq.astro';
import Talk from '../home/Talk.astro';
import { copy } from '../../content/copy';
import type { Lang } from '../../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const h = c.home;
const isPl = lang === 'pl';
---
<Base lang={lang} path={isPl ? '/' : '/en'} title={h.title} description={h.description} kind="home" faq={c.faq} ogImage={isPl ? '/og/home.png' : '/og/home-en.png'}>
  <Hero lang={lang} />
  <Thesis lang={lang} />
  <Registry lang={lang} />
  <Outreach lang={lang} />
  <Studio lang={lang} />
  <Bot lang={lang} />
  <Faq lang={lang} />
  <Talk lang={lang} />
</Base>
