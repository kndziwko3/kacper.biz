---
/** Work: each client site as a case on the sheet, the full-page capture travelling inside its frame. */
import Base from '../../layouts/Base.astro';
import PageHead from '../ui/PageHead.astro';
import Sheet from '../ui/Sheet.astro';
import Btn from '../ui/Btn.astro';
import { copy, formatDate } from '../../content/copy';
import { PRODUCTS, PROJECTS, type Lang } from '../../content/site';
import { shot } from '../../content/work';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const w = c.work;
const isPl = lang === 'pl';
const path = isPl ? '/realizacje' : '/en/work';
const home = isPl ? '/' : '/en';
const own = [
  { name: 'OutreachPilot.pl', url: PRODUCTS.outreachpilot.url, text: PRODUCTS.outreachpilot.tagline[lang], cta: 'own-op' },
  { name: 'FastLanding.io', url: PRODUCTS.fastlanding.url, text: PRODUCTS.fastlanding.tagline[lang], cta: 'own-fl' },
];
const alt = (name: string, kind: string) => (isPl ? `Strona ${name}, ${kind}` : `${name} website, ${kind}`);
---
<Base lang={lang} path={path} title={w.title} description={w.description} kind="work"
  breadcrumbs={[{ name: c.ui.home, path: home }, { name: w.crumb, path }]} ogImage={isPl ? '/og/work.png' : '/og/work-en.png'} still="p1">
  <PageHead lang={lang} crumb={w.crumb} label={w.kicker} h1={w.h1} lead={w.lead} pose={1} short guide={c.film.guide.work} />

  <Sheet id="strony" guide={c.film.guide.work}>
    <h2 class="sr-only">{w.h1}</h2>
    {PROJECTS.map((p, i) => {
      const t = shot(p.key, 'tour');
      return (
        <article class="grid case" aria-labelledby={`case-${p.key}`}>
          <header class="case-meta">
            <p class="t-label dim num">{String(i + 1).padStart(2, '0')} / {String(PROJECTS.length).padStart(2, '0')}</p>
            <h3 class="t-h2" id={`case-${p.key}`}>{p.name}</h3>
            <p class="t-body dim">{p.blurb[lang]}</p>
            <dl class="rows">
              <div><dt class="k">{w.type}</dt><dd class="v">{p.kind[lang]}</dd></div>
              <div><dt class="k">{w.langs}</dt><dd class="v">{p.langs}</dd></div>
              <div><dt class="k">{w.checked}</dt><dd class="v">{formatDate(lang, p.checked)}</dd></div>
            </dl>
            <p class="t-label dim case-on">{w.onPage}</p>
            <ul class="case-list">{(w.features[p.key] ?? []).map((f) => <li class="t-small">{f}</li>)}</ul>
            <div class="btn-row"><Btn href={p.url} newTab variant="ghost">{p.host}</Btn></div>
          </header>
          <a class="case-frame" href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <span class="case-view" data-tour>
              <picture>
                <source srcset={t.avif} type="image/avif" />
                <img src={t.webp} width={t.width} height={t.height} alt={alt(p.name, p.kind[lang])} loading="lazy" decoding="async" />
              </picture>
            </span>
          </a>
        </article>
      );
    })}
  </Sheet>

  <Sheet id="produkty" labelledby="own-h" guide={w.own.h2} dark>
    <div class="grid pg-two">
      <div class="pg-main">
        <h2 class="t-h2" id="own-h">{w.own.h2}</h2>
        <p class="t-lead dim">{w.own.p}</p>
      </div>
      <ul class="rows pg-side own">
        {own.map((o) => (<li><a class="k own-name" href={o.url} data-outbound data-cta={o.cta} rel="noopener">{o.name}</a><span class="note">{o.text}</span></li>))}
      </ul>
    </div>
  </Sheet>
</Base>
<style>
  .case { row-gap: 2.5rem; align-items: start; }
  .case + .case { margin-top: clamp(5rem, 14vh, 9rem); padding-top: clamp(3rem, 8vh, 5rem); border-top: 1px solid var(--line-p); }
  .case-meta { display: grid; gap: 1.1rem; align-content: start; }
  .case-meta .rows { margin-top: 0.5rem; }
  .case-meta .rows .v { text-align: right; }
  .case-on { margin-top: 0.75rem; }
  .case-list { display: grid; gap: 0.35rem; }
  .case-list li { padding-left: 1.1rem; position: relative; }
  .case-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.4rem; height: 1px; background: currentColor; }
  .case-frame { display: block; border-radius: 1rem; overflow: hidden; background: var(--paper-2); box-shadow: 0 0 0 1px var(--line-p), 0 40px 80px -50px rgba(21, 18, 15, 0.5); }
  .case-view { display: block; position: relative; overflow: hidden; height: min(70svh, 44rem); }
  .case-view img { width: 100%; height: auto; will-change: transform; }
  @media (min-width: 960px) {
    .case-meta { grid-column: 1 / 5; position: sticky; top: calc(var(--head-h) + 1.5rem); }
    .case-frame { grid-column: 6 / 13; }
    .case-view { height: min(82svh, 52rem); }
  }
  .own-name { font: 500 var(--t-h2)/1 var(--f-display); letter-spacing: -0.03em; transition: color 0.2s; }
  .own-name:hover { color: var(--copper-hi); }
  .own li { grid-template-columns: 1fr; }
</style>
