---
/**
 * The chapter rail on the bottom edge of the film: every chapter by name, the one on screen lit in copper
 * (main.ts sets aria-current from the chapter tracks). Links jump to a chapter; on a phone only the current name shows.
 */
interface Props { chapters: { id: string; name: string }[]; label: string }
const { chapters, label } = Astro.props;
---
<nav class="rail" aria-label={label} data-rail>
  <ol>
    {chapters.map((c, i) => (
      <li><a href={`#${c.id}`} data-rail-to={c.id} aria-current={i === 0 ? 'step' : undefined}><span class="rail-n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="rail-name">{c.name}</span></a></li>
    ))}
  </ol>
</nav>
<style>
  .rail { position: fixed; z-index: 40; left: 50%; bottom: max(1rem, env(safe-area-inset-bottom)); translate: -50% 0; transition: opacity 0.3s var(--ease), translate 0.4s var(--ease); }
  .rail ol { display: flex; gap: 0.25rem; padding: 0.3rem; border-radius: 999px; background: var(--studio); box-shadow: inset 0 0 0 1px rgba(237, 230, 218, 0.12); }
  .rail a { display: flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; padding: 0.35rem 0.85rem; border-radius: 999px; color: var(--text-2); font: 500 var(--t-label)/1 var(--f-mono); font-stretch: 87.5%; text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; transition: color 0.2s, background-color 0.2s; }
  .rail a:hover { color: #ede6da; }
  .rail a[aria-current] { color: var(--ink); background: var(--copper); }
  .rail-n { opacity: 0.7; }
  :global(html.rail-hide) .rail { opacity: 0; translate: -50% 150%; pointer-events: none; }
  @media (max-width: 759px) {
    .rail a { padding: 0.35rem 0.8rem; }
    .rail-n { display: none; }
    /* the chapters you are not in shrink to ticks; the current one keeps its name */
    .rail a:not([aria-current]) { min-width: 1.6rem; padding-inline: 0; justify-content: center; }
    .rail a:not([aria-current]) .rail-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .rail a:not([aria-current])::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  }
  @media (prefers-reduced-motion: reduce) { .rail { transition: none; } }
</style>
