---
/**
 * FastBot after hours, on the dark sheet: the business is closed (its listed hours say so), a customer writes at 22:14
 * and the bot answers. The whole sample conversation is static HTML; it lights up line by line once in view (chat.ts).
 */
import Sheet from '../ui/Sheet.astro';
import Btn from '../ui/Btn.astro';
import { copy } from '../../content/copy';
import { PRODUCTS, type Lang } from '../../content/site';
interface Props { lang: Lang; id?: string }
const { lang, id = 'fastbot' } = Astro.props;
const c = copy[lang];
const b = c.home.bot;
const m = b.chat;
---
<Sheet id={id} labelledby={`${id}-h`} guide="FastBot" dark>
  <div class="grid bt">
    <div class="bt-text">
      <p class="bt-time num" aria-hidden="true">{b.time}</p>
      <h2 class="t-h2" id={`${id}-h`}>{b.h2}</h2>
      <p class="t-lead dim">{b.p}</p>
      <p class="t-small bt-price">{b.price}</p>
      <div class="btn-row"><Btn href={PRODUCTS.fastlanding.bot} outbound cta="bot">{b.cta}</Btn></div>
    </div>
    <div class="bt-side">
      <figure class="chat" data-chat>
        <div class="chat-top">
          <span class="chat-av" aria-hidden="true">KR</span>
          <span class="chat-who"><b>{m.company}</b><span>{m.status}</span></span>
          <span class="t-label chat-hours">{c.film.botHours}</span>
        </div>
        <ol class="chat-log" aria-label={lang === 'pl' ? 'Przykładowa rozmowa' : 'Example conversation'}>
          <li class="chat-day t-label">{m.day}</li>
          <li class="msg msg--me" data-msg>{m.q1}</li>
          <li class="msg msg--bot" data-msg>{m.a1}</li>
          <li class="chips" data-msg>{m.chips.map((ch) => <span class:list={['chip', ch === m.pick && 'is-picked']}>{ch}</span>)}</li>
          <li class="msg msg--me" data-msg>{m.pick}</li>
          <li class="msg msg--bot" data-msg>{m.a2}</li>
          <li class="msg msg--me" data-msg>{m.q2}</li>
          <li class="msg-done" data-msg><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" /></svg> {m.done}</li>
        </ol>
        <figcaption class="chat-note"><span>{m.note}</span><button type="button" class="tlink" data-chat-replay hidden>{m.replay}</button></figcaption>
      </figure>
    </div>
  </div>
</Sheet>

<style>
  .bt { row-gap: 3.5rem; align-items: start; }
  .bt-text { display: grid; gap: 1.5rem; justify-items: start; align-content: start; }
  .bt-time { font: 500 clamp(4.5rem, 1.8rem + 10vw, 11.5rem)/0.8 var(--f-display); letter-spacing: -0.04em; color: var(--copper-hi); margin-bottom: 1rem; }
  .bt-price { max-width: 44ch; padding-top: 1.25rem; border-top: 1px solid var(--line-d); color: var(--text); }
  @media (min-width: 960px) {
    .bt-text { grid-column: 1 / 7; }
    .bt-side { grid-column: 8 / 13; position: sticky; top: calc(var(--head-h) + 1.5rem); }
  }

  .chat { margin: 0; background: var(--paper); color: var(--ink); border-radius: 1rem; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7); }
  .chat :focus-visible { outline-color: var(--copper-ink); }
  .chat-top { display: grid; grid-template-columns: auto 1fr; column-gap: 0.8rem; row-gap: 0.25rem; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid var(--line-p); }
  .chat-av { grid-row: span 2; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--ink); color: var(--paper); font: 500 0.8rem/1 var(--f-mono); }
  .chat-who { display: grid; gap: 0.1rem; }
  .chat-who b { font-weight: 500; }
  .chat-who span { font-size: 0.8125rem; color: var(--ink-2); }
  .chat-hours { grid-column: 2; color: var(--ink-2); }
  .chat-log { display: grid; gap: 0.6rem; padding: 1.2rem; align-content: start; }
  .chat-day { justify-self: center; color: var(--ink-2); margin-bottom: 0.3rem; }
  .msg { max-width: 84%; padding: 0.7rem 0.95rem; font-size: 0.97rem; line-height: 1.42; border-radius: 1.1rem; }
  .msg--me { justify-self: end; background: var(--ink); color: var(--paper); border-bottom-right-radius: 0.35rem; }
  .msg--bot { justify-self: start; background: var(--paper-2); border-bottom-left-radius: 0.35rem; }
  .chips { justify-self: start; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chip { padding: 0.4rem 0.8rem; border-radius: calc(var(--cap-r) - 0.15rem); box-shadow: inset 0 0 0 1px var(--line-p); font-size: 0.875rem; }
  .chip.is-picked { background: var(--copper); color: var(--ink); box-shadow: none; }
  .msg-done { justify-self: center; display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--t-small); margin-top: 0.5rem; }
  .msg-done svg { width: 16px; height: 16px; color: var(--copper-ink); }
  .chat-note { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 1.2rem; border-top: 1px solid var(--line-p); font: 400 0.75rem/1.5 var(--f-mono); color: var(--ink-2); }
  .chat-note .tlink { white-space: nowrap; }
  /* on a phone the disclaimer takes the whole row and the replay link sits under it */
  @media (max-width: 480px) { .chat-note { flex-direction: column; gap: 0.5rem; align-items: flex-start; } }
  /* while it plays (about a second), the lines still to come wait at 40%: the card keeps its full height */
  :global(.js) .chat.is-playing [data-msg] { opacity: 0.4; }
  :global(.js) .chat.is-playing [data-msg].is-shown { opacity: 1; transition: opacity 0.45s var(--ease); }
</style>
