---
import { PROJECTS, type Lang } from '../content/site';
interface Props { lang: Lang; visit: string }
const { lang, visit } = Astro.props;
---
<div class="projects">
  {PROJECTS.map((p, i) => (
    <a class="card card--link project" href={p.url} target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
      <div><small>{p.kind[lang]}</small><h3 style="margin-top:.6rem">{p.name}</h3></div>
      <p>{p.blurb[lang]}</p>
      <span class="go">{visit} <span class="arr" aria-hidden="true">↗</span></span>
    </a>
  ))}
</div>
