---
/** The last frame: the studio again, the name set large, the facts and every way to reach Kacper. */
import { NAV, CONTACT, PERSON, PRODUCTS, SALES, SITE, type Lang } from '../content/site';
import { copy } from '../content/copy';
interface Props { lang: Lang; path: string }
const { lang } = Astro.props;
const c = copy[lang];
const ft = c.ui.footer;
const privacy = lang === 'pl' ? '/polityka-prywatnosci' : '/en/privacy';
const updated = new Date(SITE.lastModified).toLocaleDateString(lang === 'pl' ? 'pl-PL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<footer class="ft" transition:animate="none">
  <div class="wrap">
    <div class="ft-top">
      <p class="ft-name" aria-hidden="true">Kacper Rękawek</p>
      <div class="ft-lead">
        <p class="t-lead">{ft.lead}</p>
        <div class="btn-row"><a class="btn" href={SALES.bookingUrl} data-outbound data-cta="footer-booking" rel="noopener">{c.film.book}</a></div>
      </div>
    </div>
    <div class="ft-cols">
      <div>
        <h2 class="t-label ft-h">{ft.products}</h2>
        <ul>
          <li><a class="tlink" href={PRODUCTS.outreachpilot.url} data-outbound data-cta="footer-op" rel="noopener">OutreachPilot.pl</a></li>
          <li><a class="tlink" href={PRODUCTS.fastlanding.url} data-outbound data-cta="footer-fl" rel="noopener">FastLanding.io</a></li>
        </ul>
      </div>
      <div>
        <h2 class="t-label ft-h">{ft.site}</h2>
        <ul>{NAV[lang].map((i) => <li><a class="tlink" href={i.href}>{i.label}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="t-label ft-h">{ft.contact}</h2>
        <ul>
          <li><a class="tlink" href={`mailto:${CONTACT.studioEmail}`}>{CONTACT.studioEmail}</a></li>
          <li><a class="tlink" href={`mailto:${CONTACT.productEmail}`}>{CONTACT.productEmail}</a></li>
          <li><a class="tlink num" href={CONTACT.aiPhone.href}>{CONTACT.aiPhone.display}</a></li>
          <li><a class="tlink" href={PERSON.linkedin} rel="me noopener" data-outbound>{ft.linkedin}</a></li>
        </ul>
      </div>
    </div>
    <div class="ft-legal t-src">
      <p>{ft.company}</p>
      <p>{ft.disambig}</p>
      <p><a class="tlink" href={privacy}>{ft.privacy}</a> · {c.ui.updated}: {updated}</p>
    </div>
  </div>
</footer>

<style>
  .ft { position: relative; z-index: 2; background: var(--studio); color: var(--text); padding-block: clamp(4rem, 12vh, 8rem) 2.5rem; border-top: 1px solid var(--line-d); }
  .ft-top { display: grid; gap: 2rem; align-items: end; padding-bottom: clamp(3rem, 8vh, 5rem); border-bottom: 1px solid var(--line-d); }
  .ft-name { font: 500 clamp(3rem, 0.8rem + 9vw, 10rem)/0.86 var(--f-sans); letter-spacing: -0.04em; }
  .ft-lead { display: grid; gap: 1.25rem; max-width: 34rem; }
  @media (min-width: 960px) { .ft-top { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); } }
  .ft-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 2rem var(--col-gap); padding-block: 2.5rem; }
  .ft-h { color: var(--text-2); margin-bottom: 0.9rem; }
  .ft-cols ul { display: grid; gap: 0.55rem; }
  .ft-legal { display: grid; gap: 0.4rem; padding-top: 1.5rem; border-top: 1px solid var(--line-d); max-width: none; }
</style>
