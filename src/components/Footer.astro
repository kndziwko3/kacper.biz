---
import { NAV, PRODUCTS, PERSON, CONTACT, SITE, ROUTE_PAIRS, type Lang } from '../content/site';
import { copy, formatDate } from '../content/copy';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = copy[lang].ui;
const f = ui.footer;
const privacy = lang === 'pl' ? '/polityka-prywatnosci' : '/en/privacy';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href={lang === 'pl' ? '/' : '/en'}>
          <span class="brand__mark" aria-hidden="true">KR</span><span>kacper<span class="faint">.biz</span></span>
        </a>
        <p class="muted" style="margin-top:1rem;max-width:34ch">{f.tagline}</p>
      </div>
      <div>
        <h2>{f.products}</h2>
        <ul>
          <li><a href={PRODUCTS.outreachpilot.url} data-outbound data-cta="footer-op" rel="noopener">OutreachPilot.pl</a></li>
          <li><a href={PRODUCTS.fastlanding.url} data-outbound data-cta="footer-fl" rel="noopener">FastLanding.io</a></li>
          <li><a href={PRODUCTS.outreachpilot.mcp} data-outbound data-cta="footer-mcp" rel="noopener">OutreachPilot MCP</a></li>
        </ul>
      </div>
      <div>
        <h2>{f.site}</h2>
        <ul>{NAV[lang].map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{f.contact}</h2>
        <ul>
          <li><a href={`mailto:${CONTACT.studioEmail}`}>{CONTACT.studioEmail}</a></li>
          <li><a href={`mailto:${CONTACT.productEmail}`}>{CONTACT.productEmail}</a></li>
          <li><a href={PERSON.linkedin} rel="me noopener" target="_blank">{f.linkedin}</a></li>
          <li><a href={privacy}>{f.privacy}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-fine">
      <p>{f.fine}<br />{f.disambig}</p>
      <p>{ui.updated}: <time datetime={SITE.lastModified}>{formatDate(lang)}</time></p>
    </div>
  </div>
</footer>
