---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../content/site';
import { copy } from '../content/copy';
import displayLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import displayExt from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-wght-normal.woff2?url';
import voiceLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  /** Mount the WebGL layer (needs at least one <section data-scene> in the page). */
  scene?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  kind?: 'home' | 'about' | 'product' | 'work' | 'contact' | 'legal';
  breadcrumbs?: { name: string; path: string }[];
  faq?: { q: string; a: string }[];
  extra?: Record<string, unknown>[];
}
const { lang, path, scene = true, ...seo } = Astro.props;
const ui = copy[lang].ui;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={voiceLatin} as="font" type="font/woff2" crossorigin />
    <Seo lang={lang} path={path} {...seo} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {umamiSrc && umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="poster" aria-hidden="true"></div>
    {scene && <canvas id="scene" aria-hidden="true"></canvas>}
    <div class="grain" aria-hidden="true"></div>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
