---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../content/site';
import { copy } from '../content/copy';
import display from '../assets/fonts/funnel-display-latin.woff2?url';
import sans from '../assets/fonts/funnel-sans-latin.woff2?url';
import mono from '../assets/fonts/martian-mono-latin.woff2?url';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  kind?: 'home' | 'about' | 'product' | 'work' | 'contact' | 'legal';
  breadcrumbs?: { name: string; path: string }[];
  faq?: { q: string; a: string }[];
  extra?: Record<string, unknown>[];
  /** The still that stands in for the film in the first viewport (preloaded; it is the LCP image). */
  still?: string;
}
const { lang, path, still, ...seo } = Astro.props;
const ui = copy[lang].ui;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    {still && <link rel="preload" as="image" href={`/stills/${still}-d.webp`} media="(min-width: 960px)" fetchpriority="high" />}
    {still && <link rel="preload" as="image" href={`/stills/${still}-m.webp`} media="(max-width: 959px)" fetchpriority="high" />}
    <Seo lang={lang} path={path} {...seo} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
    {umamiSrc && umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <canvas id="film" aria-hidden="true" transition:persist="kb-film"></canvas>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
